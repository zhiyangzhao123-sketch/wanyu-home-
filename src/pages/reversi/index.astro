---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="下一盘黑白棋 | 宛瑜的小窝"
  description="黑白棋（翻转棋）：把对方的子夹在中间就翻成自己的，最后子多者胜。你执黑，电脑执白。"
>
  <div class="rv container-content">
    <header class="rv__header">
      <h1 class="rv__title">下一盘黑白棋</h1>
      <p class="rv__lead">
        你执黑先走。落子必须夹住对方的子，被夹的会翻成你的颜色。双方都没得下时结束，子多者胜。
      </p>
    </header>

    <div class="rv__panel">
      <div class="rv__status">
        <span class="rv__turn" data-turn>黑方走</span>
        <span class="rv__score">
          <span class="rv__dot is-black" aria-hidden="true"></span><strong data-black>2</strong>
          <span class="rv__sep">:</span>
          <strong data-white>2</strong><span class="rv__dot is-white" aria-hidden="true"></span>
        </span>
      </div>

      <p class="rv__result" data-result hidden></p>

      <div class="rv__board" data-board></div>

      <div class="rv__actions">
        <button type="button" class="rv__btn" data-undo>悔棋</button>
        <button type="button" class="rv__btn rv__btn--ghost" data-new>新一局</button>
        <button type="button" class="rv__btn rv__btn--ghost" data-diff>难度：普通</button>
      </div>

      <p class="rv__note" data-note aria-live="polite"></p>
    </div>

    <p class="rv__more">
      还有<a href="/junqi/">军棋</a>、<a href="/xiangqi/">中国象棋</a>、<a href="/chess/">国际象棋</a>、<a href="/weiqi/">围棋</a>、<a href="/gobang/">五子棋</a>。 ← <a href="/">回首页</a>
    </p>
  </div>

  <script>
    import {
      createGame, play, pass, legalMoves, counts, winner, choose,
      SIZE, CELLS, BLACK, WHITE, EMPTY,
    } from "../../lib/reversi.js";

    const boardEl = document.querySelector("[data-board]") as HTMLElement;
    const turnEl = document.querySelector("[data-turn]") as HTMLElement;
    const blackEl = document.querySelector("[data-black]") as HTMLElement;
    const whiteEl = document.querySelector("[data-white]") as HTMLElement;
    const resultEl = document.querySelector("[data-result]") as HTMLElement;
    const noteEl = document.querySelector("[data-note]") as HTMLElement;
    const undoBtn = document.querySelector("[data-undo]") as HTMLButtonElement;
    const newBtn = document.querySelector("[data-new]") as HTMLButtonElement;
    const diffBtn = document.querySelector("[data-diff]") as HTMLButtonElement;

    let state = createGame();
    let history: any[] = [];
    let busy = false;
    let difficulty = 1;

    function note(text: string) {
      noteEl.textContent = text;
      if (text) window.setTimeout(() => { if (noteEl.textContent === text) noteEl.textContent = ""; }, 2400);
    }

    function render() {
      boardEl.innerHTML = "";
      const hints = state.over || state.turn !== BLACK ? [] : legalMoves(state, BLACK);
      for (let i = 0; i < CELLS; i++) {
        const cell = document.createElement("button");
        cell.type = "button";
        cell.className = "rv__cell";
        cell.dataset.pos = String(i);

        const v = state.board[i];
        if (v !== EMPTY) {
          const disc = document.createElement("span");
          disc.className = "rv__disc " + (v === BLACK ? "is-black" : "is-white");
          cell.appendChild(disc);
        } else if (hints.includes(i)) {
          cell.classList.add("is-hint");
        }

        if (state.lastMove === i) cell.classList.add("is-last");
        boardEl.appendChild(cell);
      }

      const c = counts(state.board);
      blackEl.textContent = String(c.black);
      whiteEl.textContent = String(c.white);
      turnEl.textContent = state.over
        ? "本局结束"
        : (state.turn === BLACK ? "黑方走" : "白方走") + (state.passed ? "（刚过手）" : "");
      diffBtn.textContent = "难度：" + ["简单", "普通", "困难"][difficulty];

      if (state.over) {
        const w = winner(state);
        resultEl.hidden = false;
        resultEl.textContent =
          w === BLACK ? `黑方胜 ${c.black} : ${c.white}`
          : w === WHITE ? `白方胜 ${c.white} : ${c.black}`
          : `平局 ${c.black} : ${c.white}`;
      } else {
        resultEl.hidden = true;
        resultEl.textContent = "";
      }
    }

    function afterPlayerMove() {
      // 玩家没得下就自动过手，交给电脑
      if (!state.over && legalMoves(state, BLACK).length === 0) {
        state = pass(state);
        note("你没地方下，过手了");
        render();
      }
      if (!state.over && state.turn === WHITE) aiTurn();
      else render();
    }

    function aiTurn() {
      if (state.over) return;
      busy = true;
      turnEl.textContent = "电脑在算…";
      const cfg =
        difficulty === 0 ? { depth: 1, timeMs: 300, randomness: 460 } :
        difficulty === 1 ? { depth: 4, timeMs: 700, randomness: 60 } :
        { depth: 6, timeMs: 1400, randomness: 0 };

      window.setTimeout(() => {
        const pos = choose(state.board, WHITE, cfg);
        busy = false;
        if (pos == null) {
          // 电脑没得下，过手
          state = pass(state);
          note("电脑没地方下，过手了");
          render();
          if (!state.over && legalMoves(state, BLACK).length === 0 && !state.over) {
            state = pass(state);
            render();
          }
          return;
        }
        const next = play(state, pos);
        if (next.error) {
          note(next.error);
          render();
          return;
        }
        state = next;
        render();
        if (!state.over && state.turn === BLACK && legalMoves(state, BLACK).length === 0) {
          state = pass(state);
          note("你没地方下，过手了");
          render();
          if (!state.over && state.turn === WHITE) aiTurn();
        }
      }, 160);
    }

    boardEl.addEventListener("click", (e) => {
      if (busy || state.over || state.turn !== BLACK) return;
      const cell = (e.target as HTMLElement).closest<HTMLButtonElement>(".rv__cell");
      if (!cell) return;
      const pos = Number(cell.dataset.pos);
      const next = play(state, pos);
      if (next.error) {
        note(next.error);
        return;
      }
      history.push(state);
      state = next;
      render();
      afterPlayerMove();
    });

    undoBtn.addEventListener("click", () => {
      if (busy) return;
      const steps = history.length >= 2 ? 2 : 1;
      for (let i = 0; i < steps; i++) {
        const prev = history.pop();
        if (!prev) break;
        state = prev;
      }
      render();
      note("退回去了");
    });

    newBtn.addEventListener("click", () => {
      state = createGame();
      history = [];
      busy = false;
      render();
      note("新的一局");
    });

    diffBtn.addEventListener("click", () => {
      difficulty = (difficulty + 1) % 3;
      render();
      note("难度：" + ["简单", "普通", "困难"][difficulty]);
    });

    render();
  </script>
</BaseLayout>

<style is:global>
  .rv {
    padding-block: 3rem 5rem;
  }

  .rv__header {
    max-width: 34rem;
    margin-bottom: 1.75rem;
  }

  .rv__title {
    margin: 0 0 0.6rem;
  }

  .rv__lead {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.95rem;
  }

  .rv__panel {
    max-width: 30rem;
    padding: 1.15rem;
    border: 1px solid color-mix(in srgb, var(--color-divider) 70%, transparent);
    border-radius: var(--radius-card-lg);
    background-color: var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  .rv__status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
  }

  .rv__turn {
    color: var(--color-text-primary);
    font-weight: 700;
  }

  .rv__score {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-text-primary);
    font-variant-numeric: tabular-nums;
  }

  .rv__sep {
    opacity: 0.5;
  }

  .rv__dot {
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    display: inline-block;
  }

  .rv__dot.is-black {
    background: radial-gradient(circle at 33% 30%, #4b4b4b, #101010 70%);
  }

  .rv__dot.is-white {
    background: radial-gradient(circle at 33% 30%, #ffffff, #d8d3ca 75%);
    box-shadow: inset 0 0 0 1px #b9b3a8;
  }

  .rv__result {
    margin: 0 0 0.85rem;
    padding: 0.5rem 0.85rem;
    border-radius: 10px;
    background: color-mix(in srgb, var(--color-brand) 28%, transparent);
    color: var(--color-text-primary);
    font-size: 0.92rem;
    font-weight: 700;
  }

  .rv__result[hidden] {
    display: none;
  }

  /* 绿绒盘面，黑白子一眼分明 */
  .rv__board {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    grid-template-rows: repeat(8, minmax(0, 1fr));
    aspect-ratio: 1;
    gap: 1px;
    padding: 6px;
    border-radius: 8px;
    background: #24503a;
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 10%),
      inset 0 0 30px rgb(0 0 0 / 35%),
      0 2px 6px rgb(30 40 30 / 25%);
  }

  .rv__cell {
    position: relative;
    padding: 0;
    border: 1px solid rgb(120 170 140 / 22%);
    background: #2f6247;
    cursor: pointer;
    display: grid;
    place-items: center;
    min-width: 0;
    overflow: hidden;
  }

  .rv__cell.is-hint::after {
    content: "";
    width: 26%;
    height: 26%;
    border-radius: 50%;
    background: rgb(255 255 255 / 22%);
  }

  .rv__disc {
    width: 86%;
    height: 86%;
    border-radius: 50%;
    display: block;
    transition: transform 160ms var(--ease-out-soft);
  }

  .rv__disc.is-black {
    background: radial-gradient(circle at 34% 30%, #5a5a5a 0%, #232323 45%, #050505 100%);
    box-shadow: 0 2px 4px rgb(0 0 0 / 45%), inset 0 -2px 3px rgb(0 0 0 / 60%);
  }

  .rv__disc.is-white {
    background: radial-gradient(circle at 34% 30%, #ffffff 0%, #f2efe8 45%, #cfc9be 100%);
    box-shadow: 0 2px 4px rgb(0 0 0 / 35%), inset 0 -2px 3px rgb(120 115 105 / 35%);
  }

  .rv__cell.is-last .rv__disc {
    outline: 2px solid rgb(255 214 130 / 85%);
    outline-offset: -3px;
  }

  .rv__cell:hover .rv__disc {
    transform: scale(1.03);
  }

  .rv__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1rem;
  }

  .rv__btn {
    padding: 0.45rem 0.95rem;
    border: 1px solid var(--color-brand-strong);
    border-radius: 999px;
    background-color: var(--color-brand-strong);
    color: var(--color-surface);
    font-family: inherit;
    font-size: 0.85rem;
    cursor: pointer;
  }

  .rv__btn--ghost {
    background-color: transparent;
    color: var(--color-brand-strong);
  }

  .rv__note {
    min-height: 1.3rem;
    margin: 0.7rem 0 0;
    color: var(--color-text-secondary);
    font-size: 0.83rem;
  }

  .rv__more {
    margin-top: 1.5rem;
    font-size: 0.9rem;
  }
</style>
