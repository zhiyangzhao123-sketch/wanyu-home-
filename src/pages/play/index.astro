---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="玩一会儿 · 连连看 | 宛瑜的小窝"
  description="用汉字做的一局连连看。两个同样的字，能连起来就能消掉，最多拐两个弯。"
>
  <div class="play container-content">
    <header class="play__header">
      <h1 class="play__title">玩一会儿</h1>
      <p class="play__lead">
        两个同样的字，能用不超过两个弯的线连起来，就能消掉。想不出来就洗牌，不扣分。
      </p>
    </header>

    <section class="play__panel" aria-label="连连看棋盘">
      <div class="play__stats" role="status" aria-live="polite">
        <span>剩 <strong data-left>0</strong> 对</span>
        <span>用时 <strong data-time>0:00</strong></span>
        <span>最好 <strong data-best>—</strong></span>
      </div>

      <div class="play__board" data-board></div>

      <div class="play__actions">
        <button type="button" class="play__btn" data-shuffle>洗牌</button>
        <button type="button" class="play__btn play__btn--ghost" data-restart>重来</button>
        <span class="play__note" data-note></span>
      </div>
    </section>

    <p class="play__back"><a href="/">← 回去看看别的</a></p>
  </div>
</BaseLayout>

<script>
  // 汉字连连看：同一批字打乱铺在棋盘上，两个相同的字若能用「不超过两个拐弯」
  // 的空路径连起来就消掉。路径允许绕到棋盘外一圈（经典规则）。
  const CHARS = [
    "雨", "茶", "猫", "卷", "伞", "秋",
    "风", "灯", "书", "糖", "桥", "云",
    "海", "纸", "墨", "钟", "巷", "窗",
    "树", "信", "街", "夜", "花", "光",
  ];
  const COLS = 8;
  const ROWS = 6;
  const PAD = 1; // 棋盘外一圈，路径可以从这里绕

  const boardEl = document.querySelector<HTMLElement>("[data-board]")!;
  const leftEl = document.querySelector<HTMLElement>("[data-left]")!;
  const timeEl = document.querySelector<HTMLElement>("[data-time]")!;
  const bestEl = document.querySelector<HTMLElement>("[data-best]")!;
  const noteEl = document.querySelector<HTMLElement>("[data-note]")!;
  const shuffleBtn = document.querySelector<HTMLButtonElement>("[data-shuffle]")!;
  const restartBtn = document.querySelector<HTMLButtonElement>("[data-restart]")!;

  const KEY_BEST = "wanyu_link_best";

  /** grid[r][c]：汉字，或 null 表示空。带 PAD 的外圈。 */
  let grid: (string | null)[][] = [];
  let selected: { r: number; c: number } | null = null;
  let remaining = 0;
  let startedAt = 0;
  let timer: number | undefined;

  function makeGrid() {
    const pool: string[] = [];
    for (const ch of CHARS) pool.push(ch, ch);
    for (let i = pool.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [pool[i], pool[j]] = [pool[j], pool[i]];
    }
    grid = [];
    let k = 0;
    for (let r = 0; r < ROWS + PAD * 2; r++) {
      const row: (string | null)[] = [];
      for (let c = 0; c < COLS + PAD * 2; c++) {
        const inner = r >= PAD && r < ROWS + PAD && c >= PAD && c < COLS + PAD;
        row.push(inner ? pool[k++] ?? null : null);
      }
      grid.push(row);
    }
    remaining = pool.length / 2;
  }

  function empty(r: number, c: number) {
    return grid[r]?.[c] === null;
  }

  function inBounds(r: number, c: number) {
    return r >= 0 && r < grid.length && c >= 0 && c < grid[0].length;
  }

  function clearLine(a: { r: number; c: number }, b: { r: number; c: number }) {
    // 同一行或同一列，中间全空（终点本身不算）
    if (a.r === b.r) {
      const [from, to] = a.c < b.c ? [a.c, b.c] : [b.c, a.c];
      for (let c = from + 1; c < to; c++) if (!empty(a.r, c)) return false;
      return true;
    }
    if (a.c === b.c) {
      const [from, to] = a.r < b.r ? [a.r, b.r] : [b.r, a.r];
      for (let r = from + 1; r < to; r++) if (!empty(r, a.c)) return false;
      return true;
    }
    return false;
  }

  /** 返回可行路径的折点（含两端），不可行返回 null。 */
  function findPath(
    a: { r: number; c: number },
    b: { r: number; c: number },
  ): { r: number; c: number }[] | null {
    // 0 弯
    if (clearLine(a, b)) return [a, b];

    // 1 弯：两个候选角
    for (const corner of [
      { r: a.r, c: b.c },
      { r: b.r, c: a.c },
    ]) {
      if (empty(corner.r, corner.c) && clearLine(a, corner) && clearLine(corner, b)) {
        return [a, corner, b];
      }
    }

    // 2 弯：沿 a 的行/列扫到空位，再看能否用 1 弯接到 b
    const scan = (dr: number, dc: number) => {
      let r = a.r + dr;
      let c = a.c + dc;
      while (inBounds(r, c) && empty(r, c)) {
        for (const corner of [
          { r, c: b.c },
          { r: b.r, c },
        ]) {
          if (
            inBounds(corner.r, corner.c) &&
            empty(corner.r, corner.c) &&
            clearLine({ r, c }, corner) &&
            clearLine(corner, b)
          ) {
            return [a, { r, c }, corner, b];
          }
        }
        r += dr;
        c += dc;
      }
      return null;
    };

    for (const [dr, dc] of [[0, 1], [0, -1], [1, 0], [-1, 0]]) {
      const found = scan(dr, dc);
      if (found) return found;
    }
    return null;
  }

  function anyMove() {
    const cells: { r: number; c: number; ch: string }[] = [];
    for (let r = PAD; r < ROWS + PAD; r++) {
      for (let c = PAD; c < COLS + PAD; c++) {
        const ch = grid[r][c];
        if (ch) cells.push({ r, c, ch });
      }
    }
    for (let i = 0; i < cells.length; i++) {
      for (let j = i + 1; j < cells.length; j++) {
        if (cells[i].ch === cells[j].ch && findPath(cells[i], cells[j])) return true;
      }
    }
    return false;
  }

  function shuffleBoard() {
    const cells: { r: number; c: number; ch: string }[] = [];
    for (let r = PAD; r < ROWS + PAD; r++) {
      for (let c = PAD; c < COLS + PAD; c++) {
        const ch = grid[r][c];
        if (ch) cells.push({ r, c, ch });
      }
    }
    for (let attempt = 0; attempt < 60; attempt++) {
      const chars = cells.map((x) => x.ch);
      for (let i = chars.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [chars[i], chars[j]] = [chars[j], chars[i]];
      }
      cells.forEach((cell, i) => {
        grid[cell.r][cell.c] = chars[i];
      });
      if (anyMove()) return true;
    }
    // 极端情况：怎么洗都连不上（满盘时约 3.5% 的开局如此），直接重铺一局
    makeGrid();
    return true;
  }

  function fmt(ms: number) {
    const s = Math.floor(ms / 1000);
    return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, "0")}`;
  }

  function tick() {
    timeEl.textContent = fmt(Date.now() - startedAt);
  }

  function startTimer() {
    if (timer) return;
    startedAt = Date.now();
    timer = window.setInterval(tick, 500);
  }

  function stopTimer() {
    if (timer) window.clearInterval(timer);
    timer = undefined;
  }

  function best() {
    try {
      const v = localStorage.getItem(KEY_BEST);
      return v ? Number(v) : 0;
    } catch {
      return 0;
    }
  }

  function render() {
    boardEl.style.setProperty("--cols", String(COLS));
    boardEl.innerHTML = "";
    for (let r = PAD; r < ROWS + PAD; r++) {
      for (let c = PAD; c < COLS + PAD; c++) {
        const ch = grid[r][c];
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "play__tile";
        btn.textContent = ch ?? "";
        btn.dataset.r = String(r);
        btn.dataset.c = String(c);
        if (!ch) {
          btn.classList.add("is-empty");
          btn.disabled = true;
          btn.tabIndex = -1;
        } else {
          btn.setAttribute("aria-label", `第 ${r} 行第 ${c} 列：${ch}`);
        }
        if (selected && selected.r === r && selected.c === c) btn.classList.add("is-selected");
        boardEl.appendChild(btn);
      }
    }
    leftEl.textContent = String(remaining);
    const b = best();
    bestEl.textContent = b ? fmt(b) : "—";
  }

  function note(text: string) {
    noteEl.textContent = text;
    if (text) window.setTimeout(() => (noteEl.textContent = ""), 1800);
  }

  function clicked(r: number, c: number) {
    if (!grid[r][c]) return;
    startTimer();

    if (!selected) {
      selected = { r, c };
      render();
      return;
    }
    if (selected.r === r && selected.c === c) {
      selected = null;
      render();
      return;
    }

    const first = selected;
    const a = grid[first.r][first.c];
    const b = grid[r][c];
    if (a !== b) {
      selected = { r, c };
      render();
      return;
    }

    if (!findPath(first, { r, c })) {
      note("这两个字连不上，换个顺序试试");
      selected = { r, c };
      render();
      return;
    }

    grid[first.r][first.c] = null;
    grid[r][c] = null;
    remaining -= 1;
    selected = null;
    render();

    if (remaining === 0) {
      stopTimer();
      const used = Date.now() - startedAt;
      const prev = best();
      if (!prev || used < prev) {
        try {
          localStorage.setItem(KEY_BEST, String(used));
        } catch {
          /* 隐私模式存不了，不影响玩 */
        }
        note(`全部消完，${fmt(used)}，新纪录`);
      } else {
        note(`全部消完，用时 ${fmt(used)}`);
      }
      render();
      return;
    }

    if (!anyMove()) {
      shuffleBoard();
      render();
      note("没得连了，帮你洗了一次");
    }
  }

  boardEl.addEventListener("click", (e) => {
    const t = (e.target as HTMLElement).closest<HTMLButtonElement>(".play__tile");
    if (!t || t.disabled) return;
    clicked(Number(t.dataset.r), Number(t.dataset.c));
  });

  shuffleBtn.addEventListener("click", () => {
    if (shuffleBoard()) {
      selected = null;
      render();
      note("洗好了");
    } else {
      note("这次没洗出能连的，再点一次");
    }
  });

  restartBtn.addEventListener("click", () => {
    stopTimer();
    selected = null;
    timeEl.textContent = "0:00";
    makeGrid();
    render();
  });

  makeGrid();
  if (!anyMove()) shuffleBoard();
  render();
</script>

<style is:global>
  .play {
    padding-block: 3rem 5rem;
  }

  .play__header {
    max-width: 34rem;
    margin-bottom: 2rem;
  }

  .play__title {
    margin: 0 0 0.6rem;
  }

  .play__lead {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.95rem;
  }

  .play__panel {
    padding: 1.5rem;
    border: 1px solid color-mix(in srgb, var(--color-divider) 70%, transparent);
    border-radius: var(--radius-card-lg);
    background-color: var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  .play__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-bottom: 1.1rem;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
  }

  .play__stats strong {
    color: var(--color-text-primary);
    font-variant-numeric: tabular-nums;
  }

  .play__board {
    display: grid;
    grid-template-columns: repeat(var(--cols, 8), minmax(0, 1fr));
    gap: 0.4rem;
    max-width: 640px;
  }

  .play__tile {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--color-divider) 80%, transparent);
    border-radius: 10px;
    background-color: var(--color-surface-alt);
    color: var(--color-text-primary);
    font-family: var(--font-heading);
    font-size: clamp(1rem, 2.4vw, 1.4rem);
    line-height: 1;
    cursor: pointer;
    transition:
      transform 160ms var(--ease-out-soft),
      background-color 160ms var(--ease-out-soft),
      border-color 160ms var(--ease-out-soft);
  }

  .play__tile:hover:not(.is-empty) {
    background-color: color-mix(in srgb, var(--color-brand) 26%, var(--color-surface));
  }

  .play__tile:active:not(.is-empty) {
    transform: scale(0.97);
  }

  .play__tile.is-selected {
    border-color: var(--color-brand-strong);
    background-color: color-mix(in srgb, var(--color-brand) 45%, var(--color-surface));
    box-shadow: inset 0 0 0 1px var(--color-brand-strong);
  }

  .play__tile.is-empty {
    border-color: transparent;
    background: none;
    cursor: default;
  }

  .play__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .play__btn {
    padding: 0.55rem 1.1rem;
    border: 1px solid var(--color-brand-strong);
    border-radius: 999px;
    background-color: var(--color-brand-strong);
    color: var(--color-surface);
    font-family: inherit;
    font-size: 0.9rem;
    cursor: pointer;
    transition: transform 160ms var(--ease-out-soft), opacity 160ms var(--ease-out-soft);
  }

  .play__btn:hover {
    opacity: 0.9;
  }

  .play__btn:active {
    transform: scale(0.97);
  }

  .play__btn--ghost {
    background-color: transparent;
    color: var(--color-brand-strong);
  }

  .play__note {
    color: var(--color-text-secondary);
    font-size: 0.88rem;
  }

  .play__back {
    margin-top: 2rem;
    font-size: 0.92rem;
  }

  @media (max-width: 640px) {
    .play__panel {
      padding: 1rem;
    }

    .play__board {
      gap: 0.25rem;
    }

    .play__tile {
      border-radius: 8px;
      font-size: clamp(0.9rem, 4.2vw, 1.15rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .play__tile,
    .play__btn {
      transition: none;
    }
  }
</style>
