---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ProfileCard from "../components/ProfileCard.astro";
import MusicPlayerCard from "../components/MusicPlayerCard.astro";
import AiChatWidget from "../components/AiChatWidget.astro";
import ThoughtsStrip from "../components/ThoughtsStrip.astro";
import ArticleCompactList from "../components/ArticleCompactList.astro";
import GuestbookPreview from "../components/GuestbookPreview.astro";
import PlayStrip from "../components/PlayStrip.astro";
---

<BaseLayout>
  <Hero />

  <div id="home-dashboard" class="home-dashboard container-content">
    <aside class="home-dashboard__sidebar">
      <ProfileCard />
      <MusicPlayerCard />
      <AiChatWidget />
    </aside>

    <div class="home-dashboard__main">
      <ThoughtsStrip />

      <ArticleCompactList />

      <div class="home-dashboard__band">
        <GuestbookPreview />
        <PlayStrip />
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .home-dashboard {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    padding-block: 1rem 4rem;
  }

  @media (min-width: 1024px) {
    .home-dashboard {
      grid-template-columns: 310px minmax(0, 1fr);
      gap: 2rem;
      align-items: start;
    }
  }

  .home-dashboard__sidebar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (min-width: 1024px) {
    .home-dashboard__sidebar {
      position: sticky;
      top: calc(4rem + 1.25rem);
    }
  }

  .home-dashboard__main {
    min-width: 0;
  }

  /* 文章占满；下面留言板与「玩一会儿」并排 */
  .home-dashboard__band {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1.75rem;
  }

  @media (min-width: 900px) {
    .home-dashboard__band {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
      align-items: start;
    }
  }

  /* 聊天在 310px 侧栏里：内边距收紧，消息区矮一些 */
  :global(.home-dashboard__sidebar .ai-chat) {
    margin-bottom: 0;
    padding: 1.25rem;
  }

  :global(.home-dashboard__sidebar .ai-chat__messages) {
    max-height: 240px;
  }
</style>
