---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="下一盘围棋 · 9 路 | 宛瑜的小窝"
  description="九路围棋，带提子、禁入点与打劫判定。默认和电脑下，也可以两个人轮流。"
>
  <div class="weiqi container-content">
    <header class="weiqi__header">
      <h1 class="weiqi__title">下一盘围棋</h1>
      <p class="weiqi__lead">
        九路棋盘，一局几分钟。黑先，提子、禁入点、打劫都按规矩判。
      </p>
    </header>

    <div class="weiqi__panel">
      <div class="weiqi__status">
        <span class="weiqi__turn" data-turn>轮到黑棋</span>
        <span class="weiqi__caps">提子 黑 <strong data-cap-black>0</strong> · 白 <strong data-cap-white>0</strong></span>
      </div>

      <div class="weiqi__board" data-board>
        <svg class="weiqi__svg" data-svg viewBox="-0.2 -0.2 9.4 9.4" aria-hidden="true"></svg>
        <div class="weiqi__grid" data-grid></div>
      </div>

      <div class="weiqi__actions">
        <button type="button" class="weiqi__btn" data-undo>悔棋</button>
        <button type="button" class="weiqi__btn" data-pass>停一手</button>
        <button type="button" class="weiqi__btn weiqi__btn--ghost" data-new>新一局</button>
        <button type="button" class="weiqi__btn weiqi__btn--ghost" data-mode>人机</button>
      </div>

      <p class="weiqi__note" data-note aria-live="polite"></p>
    </div>

    <p class="weiqi__more">
      还想下五子棋？<a href="/gobang/">那边有一台</a>。 ← <a href="/">回首页</a>
    </p>
  </div>

  <script>
    import { createBoard, play, pass, chooseMove, scoreArea, BLACK, WHITE, EMPTY } from "../../lib/go-engine.js";

    const svgEl = document.querySelector("[data-svg]") as unknown as SVGElement;
    const gridEl = document.querySelector("[data-grid]") as HTMLElement;
    const turnEl = document.querySelector("[data-turn]") as HTMLElement;
    const capBlackEl = document.querySelector("[data-cap-black]") as HTMLElement;
    const capWhiteEl = document.querySelector("[data-cap-white]") as HTMLElement;
    const noteEl = document.querySelector("[data-note]") as HTMLElement;
    const undoBtn = document.querySelector("[data-undo]") as HTMLButtonElement;
    const passBtn = document.querySelector("[data-pass]") as HTMLButtonElement;
    const newBtn = document.querySelector("[data-new]") as HTMLButtonElement;
    const modeBtn = document.querySelector("[data-mode]") as HTMLButtonElement;

    const SIZE = 9;
    // 九路：四角星位 + 天元
    const STARS: [number, number][] = [
      [2, 2], [2, 6],
      [6, 2], [6, 6],
      [4, 4],
    ];

    let state = createBoard(SIZE);
    const stack: any[] = [];
    let over = false;
    let busy = false;
    let vsComputer = true;

    function note(text: string) {
      noteEl.textContent = text;
      if (text) {
        window.setTimeout(() => {
          if (noteEl.textContent === text) noteEl.textContent = "";
        }, 2200);
      }
    }

    function line(x1: number, y1: number, x2: number, y2: number, w = 0.035) {
      return `<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="#6b5b45" stroke-width="${w}" stroke-linecap="square"/>`;
    }

    function drawSvg() {
      const n = SIZE;
      const out: string[] = [];

      out.push(`<rect x="-0.2" y="-0.2" width="${n + 0.4}" height="${n + 0.4}" fill="#e8d9bd"/>`);

      // 九条横线、九条竖线，都画到最外圈交叉点为止
      for (let i = 0; i < n; i++) {
        const p = i + 0.5;
        out.push(line(0.5, p, n - 0.5, p));
        out.push(line(p, 0.5, p, n - 0.5));
      }

      // 封边：外圈加一条略粗的线
      out.push(
        `<rect x="0.5" y="0.5" width="${n - 1}" height="${n - 1}" fill="none" stroke="#6b5b45" stroke-width="0.06"/>`,
      );

      // 星位与天元
      for (const [r, c] of STARS) {
        out.push(`<circle cx="${c + 0.5}" cy="${r + 0.5}" r="0.105" fill="#6b5b45"/>`);
      }

      // 棋子
      for (let i = 0; i < state.grid.length; i++) {
        const v = state.grid[i];
        if (!v) continue;
        const cx = (i % n) + 0.5;
        const cy = Math.floor(i / n) + 0.5;
        const fill = v === BLACK ? "url(#stoneBlack)" : "url(#stoneWhite)";
        const stroke = v === BLACK ? "#0b0b0b" : "#c3bdb2";
        out.push(
          `<circle cx="${cx}" cy="${cy}" r="0.44" fill="${fill}" stroke="${stroke}" stroke-width="0.02"/>`,
        );
      }

      // 最后一手标记
      const last = state.history[state.history.length - 1];
      if (last != null && last >= 0 && state.grid[last]) {
        const cx = (last % n) + 0.5;
        const cy = Math.floor(last / n) + 0.5;
        const stroke = state.grid[last] === BLACK ? "#f4f1ea" : "#33302c";
        out.push(
          `<circle cx="${cx}" cy="${cy}" r="0.13" fill="none" stroke="${stroke}" stroke-width="0.035"/>`,
        );
      }

      // 打劫点
      if (state.ko >= 0 && state.grid[state.ko] === EMPTY) {
        const cx = (state.ko % n) + 0.5;
        const cy = Math.floor(state.ko / n) + 0.5;
        out.push(
          `<rect x="${cx - 0.3}" y="${cy - 0.3}" width="0.6" height="0.6" fill="none" stroke="#b4553f" stroke-width="0.04" stroke-dasharray="0.08 0.06"/>`,
        );
      }

      const defs =
        `<defs>` +
        `<radialGradient id="stoneBlack" cx="0.35" cy="0.32" r="0.8">` +
        `<stop offset="0%" stop-color="#525252"/><stop offset="70%" stop-color="#101010"/>` +
        `</radialGradient>` +
        `<radialGradient id="stoneWhite" cx="0.35" cy="0.32" r="0.8">` +
        `<stop offset="0%" stop-color="#ffffff"/><stop offset="78%" stop-color="#d6d1c7"/>` +
        `</radialGradient>` +
        `</defs>`;

      svgEl.innerHTML = defs + out.join("");
    }

    function render() {
      drawSvg();
      gridEl.style.setProperty("--n", String(SIZE));
      gridEl.innerHTML = "";
      for (let i = 0; i < SIZE * SIZE; i++) {
        const cell = document.createElement("button");
        cell.type = "button";
        cell.className = "weiqi__point";
        cell.dataset.pos = String(i);
        const v = state.grid[i];
        cell.setAttribute(
          "aria-label",
          `第 ${Math.floor(i / SIZE) + 1} 行第 ${(i % SIZE) + 1} 列${v ? (v === BLACK ? "，黑子" : "，白子") : "，空"}`,
        );
        gridEl.appendChild(cell);
      }
      turnEl.textContent = over ? "本局结束" : state.turn === BLACK ? "轮到黑棋" : "轮到白棋";
      capBlackEl.textContent = String(state.captured[BLACK]);
      capWhiteEl.textContent = String(state.captured[WHITE]);
      modeBtn.textContent = vsComputer ? "人机" : "双人";
    }

    function endCheck() {
      if (state.passes < 2) return false;
      const sc = scoreArea(state);
      over = true;
      render();
      note(`双方停手，数子：黑 ${sc.black} · 白 ${sc.white} —— ${sc.black === sc.white ? "平局" : sc.black > sc.white ? "黑胜" : "白胜"}`);
      return true;
    }

    function doMove(pos: number, byAI = false) {
      if (over || busy) return;
      if (byAI && state.turn !== WHITE) return;
      const result = play(state, pos);
      if (result.error) {
        note(result.error);
        return;
      }
      stack.push(state);
      state = result;
      render();
      if (endCheck()) return;
      if (vsComputer && state.turn === WHITE) scheduleAI();
    }

    function scheduleAI() {
      busy = true;
      window.setTimeout(() => {
        const pos = chooseMove(state);
        busy = false;
        if (pos == null) {
          stack.push(state);
          state = pass(state);
          render();
          endCheck();
          return;
        }
        doMove(pos, true);
      }, 240);
    }

    gridEl.addEventListener("click", (e) => {
      const cell = (e.target as HTMLElement).closest<HTMLButtonElement>(".weiqi__point");
      if (!cell) return;
      if (vsComputer && state.turn === WHITE) return;
      doMove(Number(cell.dataset.pos));
    });

    undoBtn.addEventListener("click", () => {
      let steps = vsComputer && stack.length >= 2 ? 2 : 1;
      while (steps-- > 0 && stack.length) state = stack.pop();
      over = false;
      render();
      note("退回去了");
    });

    passBtn.addEventListener("click", () => {
      if (over) return;
      stack.push(state);
      state = pass(state);
      render();
      if (endCheck()) return;
      if (vsComputer && state.turn === WHITE) scheduleAI();
    });

    newBtn.addEventListener("click", () => {
      state = createBoard(SIZE);
      stack.length = 0;
      over = false;
      render();
      note("新的一局");
    });

    modeBtn.addEventListener("click", () => {
      vsComputer = !vsComputer;
      render();
      note(vsComputer ? "人机模式" : "双人轮流");
      if (vsComputer && state.turn === WHITE) scheduleAI();
    });

    render();
  </script>
</BaseLayout>

<style is:global>
  .weiqi {
    padding-block: 3rem 5rem;
  }

  .weiqi__header {
    max-width: 34rem;
    margin-bottom: 1.75rem;
  }

  .weiqi__title {
    margin: 0 0 0.6rem;
  }

  .weiqi__lead {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.95rem;
  }

  .weiqi__panel {
    max-width: 34rem;
    padding: 1.25rem;
    border: 1px solid color-mix(in srgb, var(--color-divider) 70%, transparent);
    border-radius: var(--radius-card-lg);
    background-color: var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  .weiqi__status {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.9rem;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
  }

  .weiqi__turn {
    color: var(--color-text-primary);
    font-weight: 700;
  }

  .weiqi__caps strong {
    color: var(--color-text-primary);
    font-variant-numeric: tabular-nums;
  }

  .weiqi__board {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 10px;
    overflow: hidden;
    touch-action: manipulation;
  }

  .weiqi__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .weiqi__grid {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(var(--n, 9), 1fr);
    grid-template-rows: repeat(var(--n, 9), 1fr);
  }

  .weiqi__point {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    border-radius: 4px;
  }

  .weiqi__point:hover {
    background: color-mix(in srgb, var(--color-brand) 22%, transparent);
  }

  .weiqi__point:focus-visible {
    outline: 2px solid var(--color-brand-strong);
    outline-offset: -2px;
  }

  .weiqi__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1rem;
  }

  .weiqi__btn {
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-brand-strong);
    border-radius: 999px;
    background-color: var(--color-brand-strong);
    color: var(--color-surface);
    font-family: inherit;
    font-size: 0.88rem;
    cursor: pointer;
    transition: transform 160ms var(--ease-out-soft), opacity 160ms var(--ease-out-soft);
  }

  .weiqi__btn:active {
    transform: scale(0.97);
  }

  .weiqi__btn--ghost {
    background-color: transparent;
    color: var(--color-brand-strong);
  }

  .weiqi__note {
    min-height: 1.4rem;
    margin: 0.8rem 0 0;
    color: var(--color-text-secondary);
    font-size: 0.85rem;
  }

  .weiqi__more {
    margin-top: 2rem;
    font-size: 0.92rem;
  }
</style>
