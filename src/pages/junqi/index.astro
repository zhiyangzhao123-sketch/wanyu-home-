---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="下一盘军棋（翻棋） | 宛瑜的小窝"
  description="军棋翻棋：五列十二行，五十枚棋子全部扣着，轮到你翻一枚或走一步。你执红，电脑执蓝。"
>
  <div class="jq container-content">
    <header class="jq__header">
      <h1 class="jq__title">下一盘军棋</h1>
      <p class="jq__lead">
        翻棋。五十枚棋子全扣着，轮到你：要么翻一枚，要么把自己明棋走一格。你执红。
      </p>
    </header>

    <div class="jq__panel">
      <div class="jq__status">
        <span class="jq__turn" data-turn>红方走</span>
        <span class="jq__info" data-info></span>
      </div>

      <p class="jq__result" data-result hidden></p>

      <div class="jq__board" data-board></div>

      <div class="jq__actions">
        <button type="button" class="jq__btn" data-undo>悔棋</button>
        <button type="button" class="jq__btn jq__btn--ghost" data-new>新一局</button>
        <button type="button" class="jq__btn jq__btn--ghost" data-diff>难度：普通</button>
      </div>

      <p class="jq__note" data-note aria-live="polite"></p>
    </div>

    <p class="jq__rules">
      等级：司令 &gt; 军长 &gt; 师长 &gt; 旅长 &gt; 团长 &gt; 营长 &gt; 连长 &gt; 排长 &gt; 工兵。
      同级同归于尽；炸弹碰谁都同归于尽；地雷只有工兵能挖，别的子碰它阵亡；军旗不能动，被吃到就输。
    </p>

    <p class="jq__more"><a href="/games/">← 换一盘棋</a></p>
  </div>

  <script>
    import {
      createGame, flip, move, legalMoves, legalFlips, chooseAction,
      COLS, ROWS, CELLS, SIDE_RED, SIDE_BLUE, sideName, KINDS,
    } from "../../lib/junqi.js";

    const boardEl = document.querySelector("[data-board]") as HTMLElement;
    const turnEl = document.querySelector("[data-turn]") as HTMLElement;
    const infoEl = document.querySelector("[data-info]") as HTMLElement;
    const resultEl = document.querySelector("[data-result]") as HTMLElement;
    const noteEl = document.querySelector("[data-note]") as HTMLElement;
    const undoBtn = document.querySelector("[data-undo]") as HTMLButtonElement;
    const newBtn = document.querySelector("[data-new]") as HTMLButtonElement;
    const diffBtn = document.querySelector("[data-diff]") as HTMLButtonElement;

    let state = createGame();
    let selected: number | null = null;
    let targets: number[] = [];
    let history: any[] = [];
    let busy = false;
    let difficulty = 1;

    function note(text: string) {
      noteEl.textContent = text;
      if (text) window.setTimeout(() => { if (noteEl.textContent === text) noteEl.textContent = ""; }, 2400);
    }

    function render() {
      boardEl.style.setProperty("--cols", String(COLS));
      boardEl.innerHTML = "";
      for (let i = 0; i < CELLS; i++) {
        const p = state.board[i];
        const cell = document.createElement("button");
        cell.type = "button";
        cell.className = "jq__cell";
        cell.dataset.pos = String(i);

        if (p) {
          const holder = document.createElement("span");
          holder.className = "jq__piece";
          if (p.revealed) {
            holder.classList.add("is-face", p.side === SIDE_RED ? "is-red" : "is-blue");
            const tag = document.createElement("span");
            tag.className = "jq__tag";
            tag.textContent = p.kind;
            holder.appendChild(tag);
          } else {
            holder.classList.add("is-back");
            const mark = document.createElement("span");
            mark.className = "jq__mark";
            mark.textContent = "军";
            holder.appendChild(mark);
          }
          cell.appendChild(holder);
        }

        if (selected === i) cell.classList.add("is-selected");
        if (targets.includes(i)) cell.classList.add("is-target");
        if (p && !p.revealed) cell.classList.add("is-hidden");
        boardEl.appendChild(cell);
      }

      turnEl.textContent = state.winner ? "本局结束" : sideName(state.turn) + "方走";
      infoEl.textContent = "剩 " + state.board.filter(Boolean).length + " 枚";
      diffBtn.textContent = "难度：" + ["简单", "普通", "困难"][difficulty];
      if (state.winner) {
        resultEl.hidden = false;
        resultEl.textContent = sideName(state.winner) + "方胜（" + state.reason + "）";
      } else {
        resultEl.hidden = true;
        resultEl.textContent = "";
      }
    }

    function apply(next: any) {
      if (next.error) {
        note(next.error);
        return false;
      }
      history.push(state);
      state = next;
      selected = null;
      targets = [];
      render();
      return true;
    }

    function aiTurn() {
      if (state.winner) return;
      busy = true;
      turnEl.textContent = "电脑在算…";
      window.setTimeout(() => {
        const act = chooseAction(state, SIDE_BLUE, { level: difficulty });
        busy = false;
        if (!act) { render(); return; }
        apply(act.type === "flip" ? flip(state, act.pos) : move(state, act.from, act.to));
      }, 180);
    }

    boardEl.addEventListener("click", (e) => {
      if (busy || state.winner || state.turn !== SIDE_RED) return;
      const cell = (e.target as HTMLElement).closest<HTMLButtonElement>(".jq__cell");
      if (!cell) return;
      const pos = Number(cell.dataset.pos);
      const piece = state.board[pos];

      // 点扣着的子：翻它
      if (piece && !piece.revealed) {
        if (apply(flip(state, pos))) aiTurn();
        return;
      }

      // 点自己的明棋：选中
      if (piece && piece.side === SIDE_RED) {
        if (!KINDS[piece.kind].movable) {
          note(piece.kind + "不能动");
          return;
        }
        selected = pos;
        targets = legalMoves(state, SIDE_RED).filter((m) => m.from === pos).map((m) => m.to);
        render();
        return;
      }

      // 点目标格：走
      if (selected != null && targets.includes(pos)) {
        if (apply(move(state, selected, pos))) aiTurn();
        return;
      }

      selected = null;
      targets = [];
      render();
    });

    undoBtn.addEventListener("click", () => {
      if (busy) return;
      // 人机模式退两步
      const steps = history.length >= 2 ? 2 : 1;
      for (let i = 0; i < steps; i++) {
        const prev = history.pop();
        if (!prev) break;
        state = prev;
      }
      selected = null;
      targets = [];
      render();
      note("退回去了");
    });

    newBtn.addEventListener("click", () => {
      state = createGame();
      history = [];
      selected = null;
      targets = [];
      busy = false;
      render();
      note("新的一局");
    });

    diffBtn.addEventListener("click", () => {
      difficulty = (difficulty + 1) % 3;
      render();
      note("难度：" + ["简单", "普通", "困难"][difficulty]);
    });

    render();
  </script>
</BaseLayout>

<style is:global>
  .jq {
    padding-block: 3rem 5rem;
  }

  .jq__header {
    max-width: 34rem;
    margin-bottom: 1.75rem;
  }

  .jq__title {
    margin: 0 0 0.6rem;
  }

  .jq__lead {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.95rem;
  }

  .jq__panel {
    max-width: 26rem;
    padding: 1.1rem;
    border: 1px solid color-mix(in srgb, var(--color-divider) 70%, transparent);
    border-radius: var(--radius-card-lg);
    background-color: var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  .jq__status {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.8rem;
    color: var(--color-text-secondary);
    font-size: 0.88rem;
  }

  .jq__turn {
    color: var(--color-text-primary);
    font-weight: 700;
  }

  .jq__result {
    margin: 0 0 0.8rem;
    padding: 0.5rem 0.85rem;
    border-radius: 10px;
    background: color-mix(in srgb, var(--color-brand) 28%, transparent);
    color: var(--color-text-primary);
    font-size: 0.92rem;
    font-weight: 700;
  }

  .jq__result[hidden] {
    display: none;
  }

  .jq__board {
    display: grid;
    grid-template-columns: repeat(var(--cols, 5), minmax(0, 1fr));
    gap: 0;
    padding: 8px;
    border-radius: 10px;
    background: linear-gradient(160deg, #e6d3ae 0%, #d9c296 50%, #ccb181 100%);
    box-shadow:
      inset 0 0 0 2px rgb(120 90 55 / 45%),
      inset 0 0 28px rgb(120 90 55 / 20%),
      0 1px 3px rgb(80 55 30 / 20%);
  }

  .jq__cell {
    position: relative;
    aspect-ratio: 1;
    padding: 0;
    border: 1px solid rgb(107 82 54 / 34%);
    background: transparent;
    cursor: pointer;
    display: grid;
    place-items: center;
    overflow: visible;
    min-width: 0;
  }

  /* 棋子块 */
  .jq__piece {
    position: absolute;
    inset: 8%;
    display: grid;
    place-items: center;
    border-radius: 12%;
    transition: transform 140ms var(--ease-out-soft), box-shadow 140ms var(--ease-out-soft);
  }

  /* 扣着的：深胡桃色，中性，不偏向任何一方 */
  .jq__piece.is-back {
    background: radial-gradient(circle at 30% 25%, #6b5540 0%, #55402c 55%, #3d2c1d 100%);
    box-shadow:
      inset 0 0 0 1px rgb(255 240 220 / 18%),
      inset 0 -2px 4px rgb(0 0 0 / 30%),
      0 1px 2px rgb(60 40 20 / 30%);
  }

  .jq__mark {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(0.55rem, 2.2vw, 0.85rem);
    color: rgb(240 224 198 / 72%);
    pointer-events: none;
  }

  /* 明棋：整块染色，红蓝一眼能分 */
  .jq__piece.is-face {
    border: 2px solid;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 55%),
      0 1px 2px rgb(80 55 30 / 26%);
  }

  .jq__piece.is-face.is-red {
    background: linear-gradient(180deg, #fdeee8 0%, #f6d9cf 100%);
    border-color: #b34334;
  }

  .jq__piece.is-face.is-blue {
    background: linear-gradient(180deg, #e9f0f8 0%, #d3e1f0 100%);
    border-color: #3f6389;
  }

  .jq__tag {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(0.5rem, 2vw, 0.76rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-align: center;
    pointer-events: none;
  }

  .jq__piece.is-red .jq__tag {
    color: #96281f;
  }

  .jq__piece.is-blue .jq__tag {
    color: #234a70;
  }

  .jq__cell.is-selected .jq__piece {
    box-shadow:
      0 0 0 2px #2f6f4f,
      0 2px 6px rgb(60 40 20 / 35%);
    transform: translateY(-1px);
  }

  .jq__cell.is-target::after {
    content: "";
    position: absolute;
    inset: 32%;
    border-radius: 50%;
    background: color-mix(in srgb, #2f6f4f 60%, transparent);
  }

  .jq__cell.is-hidden:hover .jq__piece {
    transform: translateY(-1px);
  }

  .jq__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1rem;
  }

  .jq__btn {
    padding: 0.45rem 0.95rem;
    border: 1px solid var(--color-brand-strong);
    border-radius: 999px;
    background-color: var(--color-brand-strong);
    color: var(--color-surface);
    font-family: inherit;
    font-size: 0.85rem;
    cursor: pointer;
  }

  .jq__btn--ghost {
    background-color: transparent;
    color: var(--color-brand-strong);
  }

  .jq__note {
    min-height: 1.3rem;
    margin: 0.7rem 0 0;
    color: var(--color-text-secondary);
    font-size: 0.83rem;
  }

  .jq__rules {
    max-width: 34rem;
    margin-top: 1.5rem;
    color: var(--color-text-secondary);
    font-size: 0.82rem;
    line-height: 1.8;
  }

  .jq__more {
    margin-top: 1.2rem;
    font-size: 0.9rem;
  }
</style>
