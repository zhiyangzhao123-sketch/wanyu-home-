---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="下一盘军棋（翻棋） | 宛瑜的小窝"
  description="军棋翻棋：五列十二行，五十枚棋子全部扣着，轮到你翻一枚或走一步。你执红，电脑执蓝。"
>
  <div class="jq container-content">
    <header class="jq__header">
      <h1 class="jq__title">下一盘军棋</h1>
      <p class="jq__lead">
        翻棋。五十枚棋子全扣着，轮到你：要么翻一枚，要么把自己明棋走一格。你执红。
      </p>
    </header>

    <div class="jq__panel">
      <div class="jq__status">
        <span class="jq__turn" data-turn>红方走</span>
        <span class="jq__info" data-info></span>
      </div>

      <p class="jq__result" data-result hidden></p>

      <div class="jq__board" data-board></div>

      <div class="jq__actions">
        <button type="button" class="jq__btn" data-undo>悔棋</button>
        <button type="button" class="jq__btn jq__btn--ghost" data-new>新一局</button>
        <button type="button" class="jq__btn jq__btn--ghost" data-diff>难度：普通</button>
      </div>

      <p class="jq__note" data-note aria-live="polite"></p>
    </div>

    <p class="jq__rules">
      等级：司令 &gt; 军长 &gt; 师长 &gt; 旅长 &gt; 团长 &gt; 营长 &gt; 连长 &gt; 排长 &gt; 工兵。
      同级同归于尽；炸弹碰谁都同归于尽；地雷只有工兵能挖，别的子碰它阵亡；军旗不能动，被吃到就输。
    </p>

    <p class="jq__more">
      还有<a href="/xiangqi/">中国象棋</a>、<a href="/chess/">国际象棋</a>、<a href="/weiqi/">围棋</a>、<a href="/gobang/">五子棋</a>。 ← <a href="/">回首页</a>
    </p>
  </div>

  <script>
    import {
      createGame, flip, move, legalMoves, legalFlips, chooseAction,
      COLS, ROWS, CELLS, SIDE_RED, SIDE_BLUE, sideName, KINDS,
    } from "../../lib/junqi.js";

    const boardEl = document.querySelector("[data-board]") as HTMLElement;
    const turnEl = document.querySelector("[data-turn]") as HTMLElement;
    const infoEl = document.querySelector("[data-info]") as HTMLElement;
    const resultEl = document.querySelector("[data-result]") as HTMLElement;
    const noteEl = document.querySelector("[data-note]") as HTMLElement;
    const undoBtn = document.querySelector("[data-undo]") as HTMLButtonElement;
    const newBtn = document.querySelector("[data-new]") as HTMLButtonElement;
    const diffBtn = document.querySelector("[data-diff]") as HTMLButtonElement;

    let state = createGame();
    let selected: number | null = null;
    let targets: number[] = [];
    let history: any[] = [];
    let busy = false;
    let difficulty = 1;

    function note(text: string) {
      noteEl.textContent = text;
      if (text) window.setTimeout(() => { if (noteEl.textContent === text) noteEl.textContent = ""; }, 2400);
    }

    function render() {
      boardEl.style.setProperty("--cols", String(COLS));
      boardEl.innerHTML = "";
      for (let i = 0; i < CELLS; i++) {
        const p = state.board[i];
        const cell = document.createElement("button");
        cell.type = "button";
        cell.className = "jq__cell";
        cell.dataset.pos = String(i);

        if (p) {
          if (p.revealed) {
            const tag = document.createElement("span");
            tag.className = "jq__tag " + (p.side === SIDE_RED ? "is-red" : "is-blue");
            tag.textContent = p.kind;
            cell.appendChild(tag);
          } else {
            const back = document.createElement("span");
            back.className = "jq__back";
            cell.appendChild(back);
          }
        }

        if (selected === i) cell.classList.add("is-selected");
        if (targets.includes(i)) cell.classList.add("is-target");
        if (p && !p.revealed) cell.classList.add("is-hidden");
        boardEl.appendChild(cell);
      }

      turnEl.textContent = state.winner ? "本局结束" : sideName(state.turn) + "方走";
      infoEl.textContent = "剩 " + state.board.filter(Boolean).length + " 枚";
      diffBtn.textContent = "难度：" + ["简单", "普通", "困难"][difficulty];
      if (state.winner) {
        resultEl.hidden = false;
        resultEl.textContent = sideName(state.winner) + "方胜（" + state.reason + "）";
      } else {
        resultEl.hidden = true;
        resultEl.textContent = "";
      }
    }

    function apply(next: any) {
      if (next.error) {
        note(next.error);
        return false;
      }
      history.push(state);
      state = next;
      selected = null;
      targets = [];
      render();
      return true;
    }

    function aiTurn() {
      if (state.winner) return;
      busy = true;
      turnEl.textContent = "电脑在算…";
      window.setTimeout(() => {
        const act = chooseAction(state, SIDE_BLUE, { level: difficulty });
        busy = false;
        if (!act) { render(); return; }
        apply(act.type === "flip" ? flip(state, act.pos) : move(state, act.from, act.to));
      }, 180);
    }

    boardEl.addEventListener("click", (e) => {
      if (busy || state.winner || state.turn !== SIDE_RED) return;
      const cell = (e.target as HTMLElement).closest<HTMLButtonElement>(".jq__cell");
      if (!cell) return;
      const pos = Number(cell.dataset.pos);
      const piece = state.board[pos];

      // 点扣着的子：翻它
      if (piece && !piece.revealed) {
        if (apply(flip(state, pos))) aiTurn();
        return;
      }

      // 点自己的明棋：选中
      if (piece && piece.side === SIDE_RED) {
        if (!KINDS[piece.kind].movable) {
          note(piece.kind + "不能动");
          return;
        }
        selected = pos;
        targets = legalMoves(state, SIDE_RED).filter((m) => m.from === pos).map((m) => m.to);
        render();
        return;
      }

      // 点目标格：走
      if (selected != null && targets.includes(pos)) {
        if (apply(move(state, selected, pos))) aiTurn();
        return;
      }

      selected = null;
      targets = [];
      render();
    });

    undoBtn.addEventListener("click", () => {
      if (busy) return;
      // 人机模式退两步
      const steps = history.length >= 2 ? 2 : 1;
      for (let i = 0; i < steps; i++) {
        const prev = history.pop();
        if (!prev) break;
        state = prev;
      }
      selected = null;
      targets = [];
      render();
      note("退回去了");
    });

    newBtn.addEventListener("click", () => {
      state = createGame();
      history = [];
      selected = null;
      targets = [];
      busy = false;
      render();
      note("新的一局");
    });

    diffBtn.addEventListener("click", () => {
      difficulty = (difficulty + 1) % 3;
      render();
      note("难度：" + ["简单", "普通", "困难"][difficulty]);
    });

    render();
  </script>
</BaseLayout>

<style is:global>
  .jq {
    padding-block: 3rem 5rem;
  }

  .jq__header {
    max-width: 34rem;
    margin-bottom: 1.75rem;
  }

  .jq__title {
    margin: 0 0 0.6rem;
  }

  .jq__lead {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.95rem;
  }

  .jq__panel {
    max-width: 26rem;
    padding: 1.1rem;
    border: 1px solid color-mix(in srgb, var(--color-divider) 70%, transparent);
    border-radius: var(--radius-card-lg);
    background-color: var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  .jq__status {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.8rem;
    color: var(--color-text-secondary);
    font-size: 0.88rem;
  }

  .jq__turn {
    color: var(--color-text-primary);
    font-weight: 700;
  }

  .jq__result {
    margin: 0 0 0.8rem;
    padding: 0.5rem 0.85rem;
    border-radius: 10px;
    background: color-mix(in srgb, var(--color-brand) 28%, transparent);
    color: var(--color-text-primary);
    font-size: 0.92rem;
    font-weight: 700;
  }

  .jq__result[hidden] {
    display: none;
  }

  .jq__board {
    display: grid;
    grid-template-columns: repeat(var(--cols, 5), minmax(0, 1fr));
    gap: 3px;
    padding: 6px;
    background: #d9c7a5;
    border-radius: 8px;
  }

  .jq__cell {
    position: relative;
    aspect-ratio: 1;
    padding: 0;
    border: 1px solid rgb(120 96 64 / 25%);
    border-radius: 4px;
    background: #f3e7ce;
    cursor: pointer;
    display: grid;
    place-items: center;
    overflow: hidden;
    min-width: 0;
  }

  .jq__back {
    width: 88%;
    height: 88%;
    border-radius: 3px;
    background:
      repeating-linear-gradient(45deg, #8a6b45 0 4px, #7a5d3b 4px 8px);
    box-shadow: inset 0 0 0 2px #f3e7ce;
  }

  .jq__tag {
    display: grid;
    place-items: center;
    width: 92%;
    height: 92%;
    border-radius: 3px;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(0.5rem, 2.1vw, 0.78rem);
    line-height: 1.1;
    text-align: center;
    letter-spacing: -0.02em;
  }

  .jq__tag.is-red {
    background: #f7e6e2;
    color: #a8332a;
    box-shadow: inset 0 0 0 1px #c98a80;
  }

  .jq__tag.is-blue {
    background: #e4ebf3;
    color: #2c4c6e;
    box-shadow: inset 0 0 0 1px #7f9bb8;
  }

  .jq__cell.is-selected {
    box-shadow: inset 0 0 0 2px #2f6f4f;
  }

  .jq__cell.is-target::after {
    content: "";
    position: absolute;
    inset: 26%;
    border-radius: 50%;
    background: color-mix(in srgb, #2f6f4f 55%, transparent);
  }

  .jq__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1rem;
  }

  .jq__btn {
    padding: 0.45rem 0.95rem;
    border: 1px solid var(--color-brand-strong);
    border-radius: 999px;
    background-color: var(--color-brand-strong);
    color: var(--color-surface);
    font-family: inherit;
    font-size: 0.85rem;
    cursor: pointer;
  }

  .jq__btn--ghost {
    background-color: transparent;
    color: var(--color-brand-strong);
  }

  .jq__note {
    min-height: 1.3rem;
    margin: 0.7rem 0 0;
    color: var(--color-text-secondary);
    font-size: 0.83rem;
  }

  .jq__rules {
    max-width: 34rem;
    margin-top: 1.5rem;
    color: var(--color-text-secondary);
    font-size: 0.82rem;
    line-height: 1.8;
  }

  .jq__more {
    margin-top: 1.2rem;
    font-size: 0.9rem;
  }
</style>
