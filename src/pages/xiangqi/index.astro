---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="下一盘象棋 | 宛瑜的小窝"
  description="中国象棋，你执红先走，对手是电脑。规则按标准判定：马腿、象眼、炮架、将帅照面、不能送将。"
>
  <div class="xq container-content">
    <header class="xq__header">
      <h1 class="xq__title">下一盘象棋</h1>
      <p class="xq__lead">
        你执红，先走。点自己的子会亮出能走的点，再点一下就走。
      </p>
    </header>

    <div class="xq__panel">
      <div class="xq__status">
        <span class="xq__turn" data-turn>红方走</span>
        <span class="xq__info" data-info></span>
      </div>

      <p class="xq__result" data-result hidden></p>

      <div class="xq__board" data-board>
        <svg class="xq__svg" data-svg viewBox="0 0 9 10" aria-hidden="true"></svg>
        <div class="xq__grid" data-grid></div>
      </div>

      <div class="xq__actions">
        <button type="button" class="xq__btn" data-undo>悔棋</button>
        <button type="button" class="xq__btn xq__btn--ghost" data-new>新一局</button>
        <button type="button" class="xq__btn xq__btn--ghost" data-diff>难度：普通</button>
      </div>

      <p class="xq__note" data-note aria-live="polite"></p>
    </div>

    <p class="xq__more">还想下围棋？<a href="/weiqi/">那边有一盘</a>。 ← <a href="/">回首页</a></p>
  </div>

  <script>
    import {
      createBoard,
      legalMoves,
      doMove,
      undoMove,
      isChecked,
      bestMove,
      colorOf,
      COLS,
      ROWS,
    } from "../../lib/xiangqi.js";

    // 红简黑繁，象棋惯例
    const GLYPH: Record<number, string> = {
      1: "帅", 2: "仕", 3: "相", 4: "马", 5: "车", 6: "炮", 7: "兵",
      9: "将", 10: "士", 11: "象", 12: "馬", 13: "車", 14: "砲", 15: "卒",
    };

    const svgEl = document.querySelector("[data-svg]") as unknown as SVGElement;
    const gridEl = document.querySelector("[data-grid]") as HTMLElement;
    const turnEl = document.querySelector("[data-turn]") as HTMLElement;
    const infoEl = document.querySelector("[data-info]") as HTMLElement;
    const noteEl = document.querySelector("[data-note]") as HTMLElement;
    const resultEl = document.querySelector("[data-result]") as HTMLElement;
    const undoBtn = document.querySelector("[data-undo]") as HTMLButtonElement;
    const newBtn = document.querySelector("[data-new]") as HTMLButtonElement;
    const diffBtn = document.querySelector("[data-diff]") as HTMLButtonElement;

    let board = createBoard();
    let side = 1;
    let selected: number | null = null;
    let targets: number[] = [];
    let history: { move: { from: number; to: number }; captured: number }[] = [];
    let over = false;
    let busy = false;
    let difficulty = 1;
    let result = ""; // 结束原因，常驻显示

    const LINE = "#6b5236";

    function note(text: string) {
      noteEl.textContent = text;
      if (text) window.setTimeout(() => { if (noteEl.textContent === text) noteEl.textContent = ""; }, 2400);
    }

    /** 棋盘线：十道横线、九道竖线（河界处断开）、两座九宫斜线、外框、楚河汉界。 */
    function drawBoard() {
      const out: string[] = [];
      const left = 0.5;
      const right = COLS - 0.5;
      const top = 0.5;
      const bottom = ROWS - 0.5;

      // 底：木纹色（铺满 9×10，和格子的均分严格对应）
      out.push(`<rect x="0" y="0" width="9" height="10" fill="#e9d9bb"/>`);
      out.push(
        `<rect x="0" y="0" width="9" height="10" fill="url(#woodGrain)" opacity="0.5"/>`,
      );

      // 横线
      for (let r = 0; r < ROWS; r++) {
        const y = r + 0.5;
        out.push(`<line x1="${left}" y1="${y}" x2="${right}" y2="${y}" stroke="${LINE}" stroke-width="0.045" stroke-linecap="square"/>`);
      }

      // 竖线：最外两条通到底，其余在河界断开
      for (let c = 0; c < COLS; c++) {
        const x = c + 0.5;
        if (c === 0 || c === COLS - 1) {
          out.push(`<line x1="${x}" y1="${top}" x2="${x}" y2="${bottom}" stroke="${LINE}" stroke-width="0.045"/>`);
        } else {
          out.push(`<line x1="${x}" y1="${top}" x2="${x}" y2="4.5" stroke="${LINE}" stroke-width="0.045"/>`);
          out.push(`<line x1="${x}" y1="5.5" x2="${x}" y2="${bottom}" stroke="${LINE}" stroke-width="0.045"/>`);
        }
      }

      // 九宫斜线
      const palaces = [
        [0.5, 0.5, 3.5, 2.5], [3.5, 0.5, 5.5, 2.5],
        [3.5, 7.5, 5.5, 9.5], [5.5, 7.5, 3.5, 9.5],
      ];
      for (const [x1, y1, x2, y2] of palaces) {
        out.push(`<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="${LINE}" stroke-width="0.045"/>`);
      }

      // 外框（双线，粗一点，像真棋盘）
      out.push(`<rect x="0.3" y="0.3" width="${right - left + 0.4}" height="${bottom - top + 0.4}" fill="none" stroke="${LINE}" stroke-width="0.07"/>`);

      // 兵、炮的定位小刻痕
      const ticks: [number, number][] = [
        [7, 0], [7, 2], [7, 4], [7, 6], [7, 8], [2, 1], [2, 7],
      ];
      for (const [r, c] of ticks) {
        const x = c + 0.5;
        const y = r + 0.5;
        const o = 0.1;
        const len = 0.12;
        for (const [dx, dy] of [[-1, -1], [1, -1], [-1, 1], [1, 1]]) {
          out.push(
            `<path d="M ${x + dx * o} ${y + dy * (o + len)} L ${x + dx * o} ${y + dy * o} L ${x + dx * (o + len)} ${y + dy * o}" fill="none" stroke="${LINE}" stroke-width="0.035"/>`,
          );
        }
      }

      // 楚河 · 漢界
      out.push(
        `<text x="2.2" y="5.05" text-anchor="middle" font-size="0.72" letter-spacing="0.22" fill="#7a5c38" opacity="0.85" style="font-family: var(--font-heading)">楚 河</text>`,
      );
      out.push(
        `<text x="6.8" y="5.05" text-anchor="middle" font-size="0.72" letter-spacing="0.22" fill="#7a5c38" opacity="0.85" style="font-family: var(--font-heading)">漢 界</text>`,
      );

      const defs = `<defs>
        <pattern id="woodGrain" width="0.9" height="0.9" patternUnits="userSpaceOnUse">
          <path d="M0 0.2 Q0.45 0.05 0.9 0.25" stroke="#c9ab7d" stroke-width="0.02" fill="none" opacity="0.35"/>
          <path d="M0 0.55 Q0.45 0.4 0.9 0.6" stroke="#c9ab7d" stroke-width="0.02" fill="none" opacity="0.25"/>
          <path d="M0 0.85 Q0.45 0.7 0.9 0.9" stroke="#c9ab7d" stroke-width="0.02" fill="none" opacity="0.2"/>
        </pattern>
      </defs>`;

      svgEl.innerHTML = defs + out.join("");
    }

    function render() {
      drawBoard();
      gridEl.style.setProperty("--cols", String(COLS));
      gridEl.innerHTML = "";
      for (let i = 0; i < ROWS * COLS; i++) {
        const cell = document.createElement("button");
        cell.type = "button";
        cell.className = "xq__cell";
        cell.dataset.pos = String(i);
        const piece = board[i];
        if (piece) {
          const span = document.createElement("span");
          span.className = "xq__piece " + (colorOf(piece) === 1 ? "is-red" : "is-black");
          span.textContent = GLYPH[piece] ?? "?";
          cell.appendChild(span);
        }
        if (selected === i) cell.classList.add("is-selected");
        if (targets.includes(i)) cell.classList.add(piece ? "is-capture" : "is-target");
        cell.setAttribute("aria-label", piece ? GLYPH[piece] : "空");
        gridEl.appendChild(cell);
      }
      turnEl.textContent = over ? "本局结束" : side === 1 ? "红方走" : "黑方走";
      infoEl.textContent = history.length ? "已走 " + history.length + " 手" : "";
      diffBtn.textContent = "难度：" + ["简单", "普通", "困难"][difficulty];
      if (result) {
        resultEl.hidden = false;
        resultEl.textContent = result;
      } else {
        resultEl.hidden = true;
        resultEl.textContent = "";
      }
    }

    function finish(text: string, reason = "") {
      over = true;
      result = reason ? text + "（" + reason + "）" : text;
      render();
      note(text);
    }

    function afterMove() {
      side = side === 1 ? 2 : 1;
      selected = null;
      targets = [];
      const moves = legalMoves(board, side);
      if (!moves.length) {
        const loser = side === 1 ? "红方" : "黑方";
        const winner = side === 1 ? "黑方" : "红方";
        const reason = isChecked(board, side) ? "将死" : "困毙，无棋可走";
        finish(winner + "胜", loser + reason);
        return false;
      }
      if (isChecked(board, side)) note((side === 1 ? "红方" : "黑方") + "被将军");
      render();
      return true;
    }

    function aiTurn() {
      busy = true;
      turnEl.textContent = "电脑在算…";
      const cfg =
        difficulty === 0 ? { depth: 1, timeMs: 400, randomness: 260 } :
        difficulty === 1 ? { depth: 2, timeMs: 900, randomness: 40 } :
        { depth: 3, timeMs: 1600, randomness: 0 };

      window.setTimeout(() => {
        const move = bestMove(board, 2, cfg);
        busy = false;
        if (!move) {
          finish("红方胜", "黑方" + (isChecked(board, 2) ? "将死" : "困毙，无棋可走"));
          return;
        }
        const captured = doMove(board, move);
        history.push({ move, captured });
        afterMove();
      }, 160);
    }

    gridEl.addEventListener("click", (e) => {
      if (over || busy || side !== 1) return;
      const cell = (e.target as HTMLElement).closest<HTMLButtonElement>(".xq__cell");
      if (!cell) return;
      const pos = Number(cell.dataset.pos);

      if (board[pos] && colorOf(board[pos]) === 1) {
        selected = pos;
        targets = legalMoves(board, 1).filter((m) => m.from === pos).map((m) => m.to);
        render();
        return;
      }

      if (selected != null && targets.includes(pos)) {
        const move = { from: selected, to: pos };
        const captured = doMove(board, move);
        history.push({ move, captured });
        if (afterMove()) aiTurn();
        return;
      }

      selected = null;
      targets = [];
      render();
    });

    undoBtn.addEventListener("click", () => {
      if (busy) return;
      const steps = history.length >= 2 ? 2 : 1;
      for (let k = 0; k < steps; k++) {
        const last = history.pop();
        if (!last) break;
        undoMove(board, last.move, last.captured);
        side = side === 1 ? 2 : 1;
      }
      over = false;
      selected = null;
      targets = [];
      render();
      note("退回去了");
    });

    newBtn.addEventListener("click", () => {
      board = createBoard();
      side = 1;
      selected = null;
      targets = [];
      history = [];
      over = false;
      busy = false;
      result = "";
      render();
      note("新的一局");
    });

    diffBtn.addEventListener("click", () => {
      difficulty = (difficulty + 1) % 3;
      render();
      note("难度：" + ["简单", "普通", "困难"][difficulty]);
    });

    render();
  </script>
</BaseLayout>

<style is:global>
  .xq {
    padding-block: 3rem 5rem;
  }

  .xq__header {
    max-width: 34rem;
    margin-bottom: 1.75rem;
  }

  .xq__title {
    margin: 0 0 0.6rem;
  }

  .xq__lead {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.95rem;
  }

  .xq__panel {
    max-width: 34rem;
    padding: 1.25rem;
    border: 1px solid color-mix(in srgb, var(--color-divider) 70%, transparent);
    border-radius: var(--radius-card-lg);
    background-color: var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  .xq__status {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.9rem;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
  }

  .xq__turn {
    color: var(--color-text-primary);
    font-weight: 700;
  }

  .xq__result {
    margin: 0 0 0.9rem;
    padding: 0.55rem 0.9rem;
    border-radius: 10px;
    background: color-mix(in srgb, var(--color-brand) 28%, transparent);
    color: var(--color-text-primary);
    font-size: 0.95rem;
    font-weight: 700;
  }

  .xq__result[hidden] {
    display: none;
  }

  .xq__board {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 10;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: inset 0 0 0 1px rgb(107 82 54 / 22%), 0 1px 3px rgb(0 0 0 / 10%);
  }

  .xq__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .xq__grid {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(var(--cols, 9), 1fr);
    grid-template-rows: repeat(10, 1fr);
  }

  .xq__cell {
    position: relative;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    display: grid;
    place-items: center;
    touch-action: manipulation;
  }

  /* 棋子：双圈鼓面，楷体字 */
  .xq__piece {
    position: relative;
    display: grid;
    place-items: center;
    width: 88%;
    height: 88%;
    border-radius: 50%;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(0.8rem, 2.5vw, 1.25rem);
    line-height: 1;
    background:
      radial-gradient(circle at 32% 28%, #fffdf7 0%, #f6ecd8 45%, #e4d2b0 100%);
    box-shadow:
      inset 0 0 0 1.5px #b99b6d,
      inset 0 0 0 4px #fffaf0,
      inset 0 0 0 5px #cdb28a,
      0 2px 3px rgb(60 40 20 / 28%),
      0 1px 0 rgb(255 255 255 / 60%) inset;
    transition: transform 140ms var(--ease-out-soft);
  }

  .xq__piece.is-red {
    color: #ab2f22;
    text-shadow: 0 1px 0 rgb(255 255 255 / 45%);
  }

  .xq__piece.is-black {
    color: #24211d;
    text-shadow: 0 1px 0 rgb(255 255 255 / 45%);
  }

  .xq__cell:active .xq__piece {
    transform: scale(0.94);
  }

  .xq__cell.is-selected .xq__piece {
    box-shadow:
      inset 0 0 0 1.5px #b99b6d,
      inset 0 0 0 4px #fffaf0,
      inset 0 0 0 5px #cdb28a,
      0 0 0 2px color-mix(in srgb, var(--color-brand-strong) 75%, transparent),
      0 2px 6px rgb(60 40 20 / 35%);
  }

  /* 可走点：空点画小圆点，有子画红圈 */
  .xq__cell.is-target::after {
    content: "";
    width: 22%;
    height: 22%;
    border-radius: 50%;
    background: color-mix(in srgb, #a8332a 60%, transparent);
  }

  .xq__cell.is-capture::after {
    content: "";
    position: absolute;
    inset: 8%;
    border-radius: 50%;
    box-shadow: inset 0 0 0 2px color-mix(in srgb, #a8332a 65%, transparent);
  }

  .xq__cell:focus-visible {
    outline: 2px solid var(--color-brand-strong);
    outline-offset: -2px;
    border-radius: 4px;
  }

  .xq__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1rem;
  }

  .xq__btn {
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-brand-strong);
    border-radius: 999px;
    background-color: var(--color-brand-strong);
    color: var(--color-surface);
    font-family: inherit;
    font-size: 0.88rem;
    cursor: pointer;
    transition: transform 160ms var(--ease-out-soft);
  }

  .xq__btn:active {
    transform: scale(0.97);
  }

  .xq__btn--ghost {
    background-color: transparent;
    color: var(--color-brand-strong);
  }

  .xq__note {
    min-height: 1.4rem;
    margin: 0.8rem 0 0;
    color: var(--color-text-secondary);
    font-size: 0.85rem;
  }

  .xq__more {
    margin-top: 2rem;
    font-size: 0.92rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .xq__piece,
    .xq__btn {
      transition: none;
    }
  }
</style>
