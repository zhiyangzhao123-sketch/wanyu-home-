---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="下一盘象棋 | 宛瑜的小窝"
  description="中国象棋，你执红先走，对手是电脑。规则按标准判定：马腿、象眼、炮架、将帅照面、不能送将。"
>
  <div class="xq container-content">
    <header class="xq__header">
      <h1 class="xq__title">下一盘象棋</h1>
      <p class="xq__lead">
        你执红，先走。点自己的子会亮出能走的点，再点一下就走。
      </p>
    </header>

    <div class="xq__panel">
      <div class="xq__status">
        <span class="xq__turn" data-turn>红方走</span>
        <span class="xq__info" data-info></span>
      </div>

      <div class="xq__board" data-board></div>

      <div class="xq__actions">
        <button type="button" class="xq__btn" data-undo>悔棋</button>
        <button type="button" class="xq__btn xq__btn--ghost" data-new>新一局</button>
        <button type="button" class="xq__btn xq__btn--ghost" data-diff>难度：普通</button>
      </div>

      <p class="xq__note" data-note aria-live="polite"></p>
    </div>

    <p class="xq__more">还想下围棋？<a href="/weiqi/">那边有一盘</a>。 ← <a href="/">回首页</a></p>
  </div>

  <script>
    import {
      createBoard,
      legalMoves,
      doMove,
      undoMove,
      isChecked,
      bestMove,
      colorOf,
      COLS,
      ROWS,
    } from "../../lib/xiangqi.js";

    // 棋子显示：红用简体，黑用繁体（象棋惯例是红简黑繁）
    const GLYPH: Record<number, string> = {
      1: "帅", 2: "仕", 3: "相", 4: "马", 5: "车", 6: "炮", 7: "兵",
      9: "将", 10: "士", 11: "象", 12: "馬", 13: "車", 14: "砲", 15: "卒",
    };

    const boardEl = document.querySelector("[data-board]") as HTMLElement;
    const turnEl = document.querySelector("[data-turn]") as HTMLElement;
    const infoEl = document.querySelector("[data-info]") as HTMLElement;
    const noteEl = document.querySelector("[data-note]") as HTMLElement;
    const undoBtn = document.querySelector("[data-undo]") as HTMLButtonElement;
    const newBtn = document.querySelector("[data-new]") as HTMLButtonElement;
    const diffBtn = document.querySelector("[data-diff]") as HTMLButtonElement;

    let board = createBoard();
    let side = 1; // 红先
    let selected: number | null = null;
    let targets: number[] = [];
    let history: { move: { from: number; to: number }; captured: number }[] = [];
    let over = false;
    let busy = false;
    let difficulty = 1; // 0 简单 / 1 普通 / 2 困难

    function note(text: string) {
      noteEl.textContent = text;
      if (text) window.setTimeout(() => { if (noteEl.textContent === text) noteEl.textContent = ""; }, 2400);
    }

    function render() {
      boardEl.style.setProperty("--cols", String(COLS));
      boardEl.innerHTML = "";
      for (let i = 0; i < ROWS * COLS; i++) {
        const cell = document.createElement("button");
        cell.type = "button";
        cell.className = "xq__cell";
        cell.dataset.pos = String(i);
        const piece = board[i];
        if (piece) {
          const span = document.createElement("span");
          span.className = "xq__piece " + (colorOf(piece) === 1 ? "is-red" : "is-black");
          span.textContent = GLYPH[piece] ?? "?";
          cell.appendChild(span);
        }
        if (selected === i) cell.classList.add("is-selected");
        if (targets.includes(i)) cell.classList.add("is-target");
        boardEl.appendChild(cell);
      }
      turnEl.textContent = over ? "本局结束" : side === 1 ? "红方走" : "黑方走";
      const cap = history.length;
      infoEl.textContent = cap ? "已走 " + cap + " 手" : "";
      diffBtn.textContent = "难度：" + ["简单", "普通", "困难"][difficulty];
    }

    function finish(text: string) {
      over = true;
      render();
      note(text);
    }

    function afterMove() {
      side = side === 1 ? 2 : 1;
      selected = null;
      targets = [];

      const moves = legalMoves(board, side);
      if (!moves.length) {
        // 象棋里没有“困毙和棋”：无棋可走就是输
        finish((side === 1 ? "红方" : "黑方") + "无棋可走，" + (side === 1 ? "黑方" : "红方") + "胜");
        return false;
      }
      if (isChecked(board, side)) note((side === 1 ? "红方" : "黑方") + "被将军");
      render();
      return true;
    }

    function aiTurn() {
      busy = true;
      turnEl.textContent = "电脑在算…";
      const cfg =
        difficulty === 0 ? { depth: 1, timeMs: 400, randomness: 260 } :
        difficulty === 1 ? { depth: 2, timeMs: 900, randomness: 40 } :
        { depth: 3, timeMs: 1600, randomness: 0 };

      window.setTimeout(() => {
        const move = bestMove(board, 2, cfg);
        busy = false;
        if (!move) {
          finish("黑方无棋可走，红方胜");
          return;
        }
        const captured = doMove(board, move);
        history.push({ move, captured });
        if (afterMove() && !over) {
          // 轮到红方，玩家自己下
        }
      }, 160);
    }

    boardEl.addEventListener("click", (e) => {
      if (over || busy || side !== 1) return;
      const cell = (e.target as HTMLElement).closest<HTMLButtonElement>(".xq__cell");
      if (!cell) return;
      const pos = Number(cell.dataset.pos);

      // 点自己的子：选中并亮出可走的点
      if (board[pos] && colorOf(board[pos]) === 1) {
        selected = pos;
        targets = legalMoves(board, 1).filter((m) => m.from === pos).map((m) => m.to);
        render();
        return;
      }

      // 点到可走的点：走
      if (selected != null && targets.includes(pos)) {
        const move = { from: selected, to: pos };
        const captured = doMove(board, move);
        history.push({ move, captured });
        if (afterMove()) aiTurn();
        return;
      }

      // 点了别处：取消选中
      selected = null;
      targets = [];
      render();
    });

    undoBtn.addEventListener("click", () => {
      if (busy) return;
      // 人机模式退两步
      const steps = history.length >= 2 ? 2 : 1;
      for (let k = 0; k < steps; k++) {
        const last = history.pop();
        if (!last) break;
        undoMove(board, last.move, last.captured);
        side = side === 1 ? 2 : 1;
      }
      over = false;
      selected = null;
      targets = [];
      render();
      note("退回去了");
    });

    newBtn.addEventListener("click", () => {
      board = createBoard();
      side = 1;
      selected = null;
      targets = [];
      history = [];
      over = false;
      busy = false;
      render();
      note("新的一局");
    });

    diffBtn.addEventListener("click", () => {
      difficulty = (difficulty + 1) % 3;
      render();
      note("难度：" + ["简单", "普通", "困难"][difficulty]);
    });

    render();
  </script>
</BaseLayout>

<style is:global>
  .xq {
    padding-block: 3rem 5rem;
  }

  .xq__header {
    max-width: 34rem;
    margin-bottom: 1.75rem;
  }

  .xq__title {
    margin: 0 0 0.6rem;
  }

  .xq__lead {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.95rem;
  }

  .xq__panel {
    max-width: 34rem;
    padding: 1.25rem;
    border: 1px solid color-mix(in srgb, var(--color-divider) 70%, transparent);
    border-radius: var(--radius-card-lg);
    background-color: var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  .xq__status {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.9rem;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
  }

  .xq__turn {
    color: var(--color-text-primary);
    font-weight: 700;
  }

  .xq__board {
    display: grid;
    grid-template-columns: repeat(var(--cols, 9), 1fr);
    aspect-ratio: 9 / 10;
    background-color: #e8d9bd;
    border-radius: 10px;
    overflow: hidden;
  }

  .xq__cell {
    position: relative;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    display: grid;
    place-items: center;
  }

  /* 棋盘线：每格画右、下两条，最后一列/行不画 */
  .xq__cell::before,
  .xq__cell::after {
    content: "";
    position: absolute;
    background-color: #6b5b45;
    opacity: 0.5;
  }

  .xq__cell::before {
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
  }

  .xq__cell::after {
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
  }

  .xq__piece {
    position: relative;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 82%;
    height: 82%;
    border-radius: 50%;
    font-family: var(--font-heading);
    font-size: clamp(0.85rem, 2.6vw, 1.3rem);
    line-height: 1;
    background: #fbf6ec;
    border: 1px solid #cdb894;
    box-shadow: 0 1px 2px rgb(0 0 0 / 12%);
  }

  .xq__piece.is-red {
    color: #a8332a;
  }

  .xq__piece.is-black {
    color: #2b2b2b;
  }

  .xq__cell.is-selected {
    background: color-mix(in srgb, var(--color-brand) 30%, transparent);
  }

  .xq__cell.is-target::before,
  .xq__cell.is-target::after {
    opacity: 0.5;
  }

  .xq__cell.is-target {
    box-shadow: inset 0 0 0 2px color-mix(in srgb, #b4553f 55%, transparent);
    border-radius: 4px;
  }

  .xq__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1rem;
  }

  .xq__btn {
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-brand-strong);
    border-radius: 999px;
    background-color: var(--color-brand-strong);
    color: var(--color-surface);
    font-family: inherit;
    font-size: 0.88rem;
    cursor: pointer;
  }

  .xq__btn:active {
    transform: scale(0.97);
  }

  .xq__btn--ghost {
    background-color: transparent;
    color: var(--color-brand-strong);
  }

  .xq__note {
    min-height: 1.4rem;
    margin: 0.8rem 0 0;
    color: var(--color-text-secondary);
    font-size: 0.85rem;
  }

  .xq__more {
    margin-top: 2rem;
    font-size: 0.92rem;
  }
</style>
