---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="连连看 · AI 版 | 宛瑜的小窝"
  description="经典连连看，牌面换成 AI 公司的 logo：两个相同的图案，拐弯不超过两次就能连起来消掉。"
>
  <div class="ll container-content">
    <header class="ll__header">
      <h1 class="ll__title">连连看 · AI 版</h1>
      <p class="ll__lead">
        牌面是各家 AI 公司的 logo。两个相同的图案，只要能用不超过两个拐弯的线连起来，就能消掉。
      </p>
    </header>

    <div class="ll__panel">
      <div class="ll__status">
        <span>剩 <strong data-left>0</strong> 对</span>
        <span>用时 <strong data-time>0:00</strong></span>
        <span>最好 <strong data-best>—</strong></span>
      </div>

      <div class="ll__board" data-board>
        <svg class="ll__lines" data-lines aria-hidden="true"></svg>
        <div class="ll__grid" data-grid></div>
      </div>

      <div class="ll__actions">
        <button type="button" class="ll__btn" data-hint>提示</button>
        <button type="button" class="ll__btn" data-shuffle>洗牌</button>
        <button type="button" class="ll__btn ll__btn--ghost" data-new>重来</button>
      </div>

      <p class="ll__note" data-note aria-live="polite"></p>
    </div>

    <p class="ll__credit">
      图案来自 <a href="https://simpleicons.org/" rel="noopener" target="_blank">Simple Icons</a>（图标文件 CC0），
      以及 OpenAI 官方标识。商标归各公司所有，这里仅作游戏图案使用，与任何公司无关。
    </p>

    <p class="ll__more"><a href="/mini/">← 回小游戏</a></p>
  </div>

  <script>
    import {
      createBoard, findPath, findPair, reshuffle, countMoves, remainingPairs, MIN_MOVES,
    } from "../../../lib/linklink.js";

    const LOGOS = [
      { id: "openai", name: "OpenAI" },
      { id: "anthropic", name: "Anthropic" },
      { id: "deepseek", name: "DeepSeek" },
      { id: "googlegemini", name: "Gemini" },
      { id: "meta", name: "Meta" },
      { id: "mistralai", name: "Mistral" },
      { id: "huggingface", name: "Hugging Face" },
      { id: "moonshotai", name: "Moonshot" },
      { id: "nvidia", name: "NVIDIA" },
      { id: "ollama", name: "Ollama" },
      { id: "langchain", name: "LangChain" },
      { id: "perplexity", name: "Perplexity" },
    ];

    const COLS = 10;
    const ROWS = 7;

    const boardEl = document.querySelector("[data-board]") as HTMLElement;
    const gridEl = document.querySelector("[data-grid]") as HTMLElement;
    const linesEl = document.querySelector("[data-lines]") as unknown as SVGElement;
    const leftEl = document.querySelector("[data-left]") as HTMLElement;
    const timeEl = document.querySelector("[data-time]") as HTMLElement;
    const bestEl = document.querySelector("[data-best]") as HTMLElement;
    const noteEl = document.querySelector("[data-note]") as HTMLElement;
    const hintBtn = document.querySelector("[data-hint]") as HTMLButtonElement;
    const shuffleBtn = document.querySelector("[data-shuffle]") as HTMLButtonElement;
    const newBtn = document.querySelector("[data-new]") as HTMLButtonElement;

    const KEY_BEST = "wanyu_linklink_best";

    let board = createBoard(COLS, ROWS, LOGOS.map((l) => l.id));
    let selected: number | null = null;
    let startedAt = 0;
    let timer: number | undefined;
    let hinted: number[] = [];
    let done = false;
    let locked = false;

    function logoMeta(id: string) {
      return LOGOS.find((l) => l.id === id) ?? { id, name: id };
    }

    function fmt(ms: number) {
      const s = Math.floor(ms / 1000);
      return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, "0")}`;
    }

    function best() {
      try {
        const v = localStorage.getItem(KEY_BEST);
        return v ? Number(v) : 0;
      } catch {
        return 0;
      }
    }

    function note(text: string) {
      noteEl.textContent = text;
      if (text) window.setTimeout(() => { if (noteEl.textContent === text) noteEl.textContent = ""; }, 1800);
    }

    function startTimer() {
      if (timer) return;
      startedAt = Date.now();
      timer = window.setInterval(() => {
        if (!done) timeEl.textContent = fmt(Date.now() - startedAt);
      }, 500);
    }

    function stopTimer() {
      if (timer) window.clearInterval(timer);
      timer = undefined;
    }

    function cellAt(pos: number) {
      return gridEl.querySelector<HTMLElement>(`[data-pos="${pos}"]`);
    }

    function render() {
      gridEl.style.setProperty("--cols", String(COLS));
      gridEl.innerHTML = "";
      for (let i = 0; i < COLS * ROWS; i++) {
        const value = board.grid[i];
        const cell = document.createElement("button");
        cell.type = "button";
        cell.className = "ll__cell";
        cell.dataset.pos = String(i);

        if (value) {
          const meta = logoMeta(value);
          const img = document.createElement("img");
          img.src = `/mini/logos/${meta.id}${meta.id === "openai" ? ".png" : ".svg"}`;
          img.alt = "";
          img.loading = "eager";
          img.decoding = "sync";
          img.className = "ll__logo";
          cell.appendChild(img);
          cell.title = meta.name;
          cell.setAttribute("aria-label", meta.name);
        } else {
          cell.classList.add("is-empty");
          cell.disabled = true;
        }

        if (selected === i) cell.classList.add("is-selected");
        if (hinted.includes(i)) cell.classList.add("is-hinted");
        gridEl.appendChild(cell);
      }

      leftEl.textContent = String(remainingPairs(board));
      const b = best();
      bestEl.textContent = b ? fmt(b) : "—";
    }

    /** 把路径点画成折线，短暂显示后淡出。 */
    function showPath(points: number[][]) {
      const boardRect = boardEl.getBoundingClientRect();
      const coords = points.map(([r, c]) => {
        const cell = cellAt(r * COLS + c);
        if (!cell) return null;
        const rect = cell.getBoundingClientRect();
        return [
          rect.left - boardRect.left + rect.width / 2,
          rect.top - boardRect.top + rect.height / 2,
        ];
      }).filter(Boolean) as number[][];

      if (coords.length < 2) return;

      linesEl.setAttribute("viewBox", `0 0 ${boardRect.width} ${boardRect.height}`);
      linesEl.setAttribute("width", String(boardRect.width));
      linesEl.setAttribute("height", String(boardRect.height));
      linesEl.innerHTML =
        `<polyline points="${coords.map((p) => p.join(",")).join(" ")}" fill="none" stroke="#2f6f4f" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="6 5" class="ll__path"/>` +
        coords
          .map((p) => `<circle cx="${p[0]}" cy="${p[1]}" r="4" fill="#2f6f4f" class="ll__node"/>`)
          .join("");

      linesEl.classList.add("is-on");
      window.setTimeout(() => {
        linesEl.classList.remove("is-on");
        linesEl.innerHTML = "";
      }, 380);
    }

    function finishIfDone() {
      if (remainingPairs(board) > 0) return false;
      done = true;
      stopTimer();
      const used = Date.now() - startedAt;
      const prev = best();
      if (!prev || used < prev) {
        try { localStorage.setItem(KEY_BEST, String(used)); } catch { /* 隐私模式 */ }
        note(`全部消完，${fmt(used)}，新纪录`);
      } else {
        note(`全部消完，用时 ${fmt(used)}`);
      }
      render();
      return true;
    }

    function clicked(pos: number) {
      if (done || locked || !board.grid[pos]) return;
      startTimer();
      hinted = [];

      if (selected === null) {
        selected = pos;
        render();
        return;
      }
      if (selected === pos) {
        selected = null;
        render();
        return;
      }

      const first = selected;
      if (board.grid[first] !== board.grid[pos]) {
        selected = pos;
        render();
        return;
      }

      const path = findPath(board, first, pos);
      if (!path) {
        note("这两个连不上，中间被挡住了");
        selected = pos;
        render();
        for (const p of [first, pos]) {
          const el = cellAt(p);
          if (el) {
            el.classList.add("is-invalid");
            window.setTimeout(() => el.classList.remove("is-invalid"), 450);
          }
        }
        return;
      }

      // 有路：画线 → 两块弹一下 → 消除
      locked = true;
      showPath(path);
      for (const p of [first, pos]) cellAt(p)?.classList.add("is-matching");

      window.setTimeout(() => {
        board.grid[first] = null;
        board.grid[pos] = null;
        selected = null;
        locked = false;
        render();

        if (finishIfDone()) return;
        if (countMoves(board) === 0) {
          reshuffle(board);
          render();
          note("没得连了，帮你洗了一次");
        }
      }, 300);
    }

    gridEl.addEventListener("click", (e) => {
      const cell = (e.target as HTMLElement).closest<HTMLButtonElement>(".ll__cell");
      if (!cell || cell.disabled) return;
      clicked(Number(cell.dataset.pos));
    });

    hintBtn.addEventListener("click", () => {
      if (done) return;
      const pair = findPair(board);
      if (!pair) {
        reshuffle(board);
        render();
        note("没有能连的，帮你洗牌");
        return;
      }
      hinted = pair;
      render();
      const path = findPath(board, pair[0], pair[1]);
      if (path) showPath(path);
      note("这两块可以连");
      window.setTimeout(() => { hinted = []; render(); }, 1600);
    });

    shuffleBtn.addEventListener("click", () => {
      if (done) return;
      for (let i = 0; i < 50 && countMoves(board) < MIN_MOVES; i++) reshuffle(board);
      selected = null;
      hinted = [];
      render();
      note("洗好了");
    });

    newBtn.addEventListener("click", () => {
      stopTimer();
      board = createBoard(COLS, ROWS, LOGOS.map((l) => l.id));
      selected = null;
      hinted = [];
      done = false;
      locked = false;
      timeEl.textContent = "0:00";
      render();
      note("新的一局");
    });

    render();
  </script>
</BaseLayout>

<style is:global>
  .ll {
    padding-block: 3rem 5rem;
  }

  .ll__header {
    max-width: 34rem;
    margin-bottom: 1.75rem;
  }

  .ll__title {
    margin: 0 0 0.6rem;
  }

  .ll__lead {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.95rem;
  }

  .ll__panel {
    max-width: 40rem;
    padding: 1.15rem;
    border: 1px solid color-mix(in srgb, var(--color-divider) 70%, transparent);
    border-radius: var(--radius-card-lg);
    background-color: var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  .ll__status {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-bottom: 0.9rem;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
  }

  .ll__status strong {
    color: var(--color-text-primary);
    font-variant-numeric: tabular-nums;
  }

  .ll__board {
    position: relative;
    border-radius: 10px;
    background: linear-gradient(160deg, #e8d5b3 0%, #d9c296 100%);
    box-shadow: inset 0 0 0 1px rgb(120 90 55 / 30%);
    padding: 8px;
  }

  .ll__grid {
    display: grid;
    grid-template-columns: repeat(var(--cols, 10), minmax(0, 1fr));
    gap: 4px;
  }

  /* 连线层：盖在棋盘上，不接收点击 */
  .ll__lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    transition: opacity 160ms var(--ease-out-soft);
    z-index: 3;
  }

  .ll__lines.is-on {
    opacity: 1;
  }

  .ll__path {
    filter: drop-shadow(0 1px 2px rgb(20 60 40 / 35%));
    animation: ll-dash 360ms linear;
  }

  @keyframes ll-dash {
    from { stroke-dashoffset: 22; opacity: 0.2; }
    to { stroke-dashoffset: 0; opacity: 1; }
  }

  .ll__node {
    animation: ll-pop 360ms var(--ease-out-soft);
  }

  @keyframes ll-pop {
    from { transform: scale(0.2); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }

  .ll__cell {
    position: relative;
    aspect-ratio: 1;
    padding: 0;
    border: 1px solid rgb(120 96 64 / 25%);
    border-radius: 6px;
    background: linear-gradient(180deg, #fdf8ee 0%, #f3e8d3 100%);
    cursor: pointer;
    display: grid;
    place-items: center;
    min-width: 0;
    overflow: hidden;
    transition: transform 120ms var(--ease-out-soft), box-shadow 120ms var(--ease-out-soft);
  }

  .ll__cell:hover:not(.is-empty) {
    transform: translateY(-1px);
    box-shadow: 0 2px 5px rgb(80 55 30 / 22%);
  }

  .ll__logo {
    width: 68%;
    height: 68%;
    object-fit: contain;
    pointer-events: none;
  }

  .ll__cell.is-empty {
    border-color: transparent;
    background: transparent;
    cursor: default;
  }

  .ll__cell.is-selected {
    box-shadow: inset 0 0 0 2px #2f6f4f, 0 0 0 2px rgb(47 111 79 / 35%);
    background: linear-gradient(180deg, #eef7ef 0%, #dcf0df 100%);
  }

  .ll__cell.is-hinted {
    box-shadow: 0 0 0 2px #d6a53c;
  }

  .ll__cell.is-matching {
    animation: ll-match 300ms var(--ease-out-soft) forwards;
  }

  @keyframes ll-match {
    0% { transform: scale(1); box-shadow: 0 0 0 0 rgb(47 111 79 / 0%); }
    40% { transform: scale(1.12); box-shadow: 0 0 0 4px rgb(47 111 79 / 45%); }
    100% { transform: scale(0.4); opacity: 0; }
  }

  .ll__cell.is-invalid {
    border-color: #b4553f;
    background: linear-gradient(180deg, #fbe7e1 0%, #f6d5cc 100%);
    animation: ll-shake 300ms;
  }

  @keyframes ll-shake {
    0%, 100% { transform: translateX(0); }
    30% { transform: translateX(-2px); }
    70% { transform: translateX(2px); }
  }

  .ll__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1rem;
  }

  .ll__btn {
    padding: 0.45rem 0.95rem;
    border: 1px solid var(--color-brand-strong);
    border-radius: 999px;
    background-color: var(--color-brand-strong);
    color: var(--color-surface);
    font-family: inherit;
    font-size: 0.85rem;
    cursor: pointer;
  }

  .ll__btn--ghost {
    background-color: transparent;
    color: var(--color-brand-strong);
  }

  .ll__note {
    min-height: 1.3rem;
    margin: 0.7rem 0 0;
    color: var(--color-text-secondary);
    font-size: 0.85rem;
  }

  .ll__credit {
    max-width: 40rem;
    margin-top: 1.25rem;
    color: var(--color-text-secondary);
    font-size: 0.78rem;
    line-height: 1.7;
  }

  .ll__more {
    margin-top: 1.5rem;
    font-size: 0.9rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .ll__path,
    .ll__node,
    .ll__cell.is-matching,
    .ll__cell.is-invalid {
      animation: none;
    }
  }
</style>
