---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="贪吃蛇 | 宛瑜的小窝"
  description="经典贪吃蛇：方向键或滑动控制，吃果子变长，越长越快，撞墙撞自己就结束。"
>
  <div class="sn container-content">
    <header class="sn__header">
      <h1 class="sn__title">贪吃蛇</h1>
      <p class="sn__lead">
        方向键或 WASD 控制，空格暂停。手机上直接滑动屏幕。
      </p>
    </header>

    <div class="sn__panel">
      <div class="sn__hud">
        <span>分数 <strong data-score>0</strong></span>
        <span>长度 <strong data-len>3</strong></span>
        <span>最好 <strong data-best>0</strong></span>
      </div>

      <div class="sn__stage">
        <canvas class="sn__canvas" data-canvas width="400" height="400" aria-label="游戏区"></canvas>
        <div class="sn__overlay" data-overlay hidden>
          <p class="sn__over-text" data-over-text>结束了</p>
          <button type="button" class="sn__btn" data-again>再来一局</button>
        </div>
      </div>

      <div class="sn__pad">
        <button type="button" class="sn__key" data-dir="up" aria-label="上">↑</button>
        <button type="button" class="sn__key" data-dir="left" aria-label="左">←</button>
        <button type="button" class="sn__key" data-dir="down" aria-label="下">↓</button>
        <button type="button" class="sn__key" data-dir="right" aria-label="右">→</button>
        <button type="button" class="sn__key sn__key--wide" data-pause>暂停</button>
      </div>
    </div>

    <p class="sn__more"><a href="/mini/">← 回小游戏</a></p>
  </div>

  <script>
    import { createGame, step, turn, tickInterval, COLS, ROWS, DIRS } from "../../../lib/snake.js";

    // 出错时把信息挂在 DOM 上，方便排查（也避免静默停止）
    window.addEventListener("error", (e) => {
      document.documentElement.dataset.err = String(e.message);
    });

    const canvas = document.querySelector("[data-canvas]") as HTMLCanvasElement;
    const overlay = document.querySelector("[data-overlay]") as HTMLElement;
    const overText = document.querySelector("[data-over-text]") as HTMLElement;
    const scoreEl = document.querySelector("[data-score]") as HTMLElement;
    const lenEl = document.querySelector("[data-len]") as HTMLElement;
    const bestEl = document.querySelector("[data-best]") as HTMLElement;
    const againBtn = document.querySelector("[data-again]") as HTMLButtonElement;
    const pauseBtn = document.querySelector("[data-pause]") as HTMLButtonElement;

    const ctx = canvas.getContext("2d")!;
    const CELL = canvas.width / COLS;
    const KEY_BEST = "wanyu_snake_best";

    let game = createGame();
    let paused = false;

    function bestScore() {
      try { return Number(localStorage.getItem(KEY_BEST) ?? 0); } catch { return 0; }
    }
    function saveBest(v: number) {
      try { localStorage.setItem(KEY_BEST, String(v)); } catch { /* 忽略 */ }
    }

    /** 圆角矩形（不依赖 ctx.roundRect，老内核也能画）。 */
    function roundRect(x: number, y: number, w: number, h: number, r: number) {
      const rr = Math.min(r, w / 2, h / 2);
      ctx.beginPath();
      ctx.moveTo(x + rr, y);
      ctx.lineTo(x + w - rr, y);
      ctx.quadraticCurveTo(x + w, y, x + w, y + rr);
      ctx.lineTo(x + w, y + h - rr);
      ctx.quadraticCurveTo(x + w, y + h, x + w - rr, y + h);
      ctx.lineTo(x + rr, y + h);
      ctx.quadraticCurveTo(x, y + h, x, y + h - rr);
      ctx.lineTo(x, y + rr);
      ctx.quadraticCurveTo(x, y, x + rr, y);
      ctx.closePath();
      ctx.fill();
    }

    function draw() {
      // 底
      ctx.fillStyle = "#f6efe0";
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // 淡格线
      ctx.strokeStyle = "rgba(120,96,64,0.07)";
      for (let i = 1; i < COLS; i++) {
        ctx.beginPath();
        ctx.moveTo(i * CELL, 0);
        ctx.lineTo(i * CELL, canvas.height);
        ctx.stroke();
        ctx.beginPath();
        ctx.moveTo(0, i * CELL);
        ctx.lineTo(canvas.width, i * CELL);
        ctx.stroke();
      }

      // 果子
      if (game.food) {
        const cx = game.food.x * CELL + CELL / 2;
        const cy = game.food.y * CELL + CELL / 2;
        ctx.fillStyle = "#c85a4a";
        ctx.beginPath();
        ctx.arc(cx, cy, CELL * 0.32, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = "rgba(255,255,255,0.45)";
        ctx.beginPath();
        ctx.arc(cx - CELL * 0.1, cy - CELL * 0.1, CELL * 0.1, 0, Math.PI * 2);
        ctx.fill();
      }

      // 蛇：由尾到头，颜色渐深
      game.snake.forEach((seg, idx) => {
        const t = idx / Math.max(1, game.snake.length - 1);
        const g = Math.round(180 - t * 60);
        ctx.fillStyle = `rgb(${Math.round(70 + t * 10)}, ${g}, ${Math.round(110 - t * 30)})`;
        const x = seg.x * CELL + 1;
        const y = seg.y * CELL + 1;
        const size = CELL - 2;
        const r = idx === 0 ? size * 0.32 : size * 0.24;
        roundRect(x, y, size, size, r);

        if (idx === 0) {
          // 眼睛
          ctx.fillStyle = "#fdfaf3";
          const d = DIRS[game.dir];
          const ex = seg.x * CELL + CELL / 2;
          const ey = seg.y * CELL + CELL / 2;
          const ox = d.x !== 0 ? d.x * CELL * 0.14 : 0;
          const oy = d.y !== 0 ? d.y * CELL * 0.14 : 0;
          const px = d.x !== 0 ? 0 : CELL * 0.16;
          const py = d.y !== 0 ? 0 : CELL * 0.16;
          for (const sgn of [-1, 1]) {
            ctx.beginPath();
            ctx.arc(ex + ox + sgn * px, ey + oy + sgn * py, CELL * 0.09, 0, Math.PI * 2);
            ctx.fill();
          }
        }
      });

      if (paused && !game.dead) {
        ctx.fillStyle = "rgba(250,246,238,0.85)";
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.fillStyle = "#5b5148";
        ctx.font = "600 20px system-ui, sans-serif";
        ctx.textAlign = "center";
        ctx.fillText("暂停", canvas.width / 2, canvas.height / 2);
      }
    }

    function updateHud() {
      scoreEl.textContent = String(game.score);
      lenEl.textContent = String(game.snake.length);
      bestEl.textContent = String(bestScore());
      pauseBtn.textContent = paused ? "继续" : "暂停";
    }

    function die() {
      if (game.score > bestScore()) saveBest(game.score);
      overText.textContent = `结束了，${game.score} 分`;
      overlay.hidden = false;
      updateHud();
    }

    let ticker: number | undefined;

    function scheduleTick() {
      if (ticker) window.clearTimeout(ticker);
      const interval = tickInterval(game.score);
      ticker = window.setTimeout(() => {
        if (game.dead || paused) return;
        step(game);
        updateHud();
        draw();
        if (game.dead) {
          die();
          return;
        }
        scheduleTick();
      }, interval);
    }

    function restart() {
      game = createGame();
      paused = false;
      overlay.hidden = true;
      updateHud();
      draw();
      scheduleTick();
    }

    function setDir(dir: "up" | "down" | "left" | "right") {
      if (game.dead || paused) return;
      turn(game, dir);
    }

    document.addEventListener("keydown", (e) => {
      const k = e.key;
      if (["ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight", " "].includes(k)) e.preventDefault();
      if (k === "ArrowUp" || k === "w" || k === "W") setDir("up");
      else if (k === "ArrowDown" || k === "s" || k === "S") setDir("down");
      else if (k === "ArrowLeft" || k === "a" || k === "A") setDir("left");
      else if (k === "ArrowRight" || k === "d" || k === "D") setDir("right");
      else if (k === " ") {
        if (!game.dead) {
          paused = !paused;
          updateHud();
          draw();
          if (!paused) scheduleTick();
        }
      }
    });

    // 手机：滑动
    let touchStart: { x: number; y: number } | null = null;
    canvas.addEventListener("touchstart", (e) => {
      const t = e.changedTouches[0];
      touchStart = { x: t.clientX, y: t.clientY };
    }, { passive: true });
    canvas.addEventListener("touchend", (e) => {
      if (!touchStart) return;
      const t = e.changedTouches[0];
      const dx = t.clientX - touchStart.x;
      const dy = t.clientY - touchStart.y;
      if (Math.abs(dx) < 18 && Math.abs(dy) < 18) return;
      if (Math.abs(dx) > Math.abs(dy)) setDir(dx > 0 ? "right" : "left");
      else setDir(dy > 0 ? "down" : "up");
      touchStart = null;
    }, { passive: true });

    document.querySelectorAll("[data-dir]").forEach((btn) => {
      btn.addEventListener("click", () => setDir((btn as HTMLElement).dataset.dir as any));
    });

    pauseBtn.addEventListener("click", () => {
      if (game.dead) return;
      paused = !paused;
      updateHud();
      draw();
      if (!paused) scheduleTick();
    });
    againBtn.addEventListener("click", restart);

    restart();
  </script>
</BaseLayout>

<style is:global>
  .sn {
    padding-block: 3rem 5rem;
  }

  .sn__header {
    max-width: 34rem;
    margin-bottom: 1.5rem;
  }

  .sn__title {
    margin: 0 0 0.6rem;
  }

  .sn__lead {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.95rem;
  }

  .sn__panel {
    max-width: 26rem;
    padding: 1.1rem;
    border: 1px solid color-mix(in srgb, var(--color-divider) 70%, transparent);
    border-radius: var(--radius-card-lg);
    background-color: var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  .sn__hud {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 0.8rem;
    color: var(--color-text-secondary);
    font-size: 0.88rem;
  }

  .sn__hud strong {
    color: var(--color-text-primary);
    font-variant-numeric: tabular-nums;
  }

  .sn__stage {
    position: relative;
  }

  .sn__canvas {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
    background: #f6efe0;
    box-shadow: inset 0 0 0 1px rgb(120 96 64 / 30%);
    touch-action: none;
  }

  .sn__overlay {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    gap: 0.9rem;
    text-align: center;
    background: rgb(250 246 238 / 90%);
    border-radius: 8px;
  }

  .sn__overlay[hidden] {
    display: none;
  }

  .sn__over-text {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.05rem;
  }

  .sn__pad {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.45rem;
    margin-top: 0.9rem;
  }

  .sn__key {
    padding: 0.55rem 0;
    border: 1px solid color-mix(in srgb, var(--color-brand-strong) 40%, transparent);
    border-radius: 10px;
    background: color-mix(in srgb, var(--color-brand) 22%, var(--color-surface));
    color: var(--color-text-primary);
    font-family: inherit;
    font-size: 1rem;
    cursor: pointer;
    user-select: none;
    touch-action: manipulation;
  }

  .sn__key:active {
    transform: scale(0.97);
  }

  .sn__key--wide {
    grid-column: span 1;
    font-size: 0.9rem;
  }

  .sn__btn {
    padding: 0.5rem 1.1rem;
    border: 1px solid var(--color-brand-strong);
    border-radius: 999px;
    background-color: var(--color-brand-strong);
    color: var(--color-surface);
    font-family: inherit;
    font-size: 0.88rem;
    cursor: pointer;
  }

  .sn__more {
    margin-top: 1.5rem;
    font-size: 0.9rem;
  }
</style>
