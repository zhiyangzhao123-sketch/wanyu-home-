---
import BaseLayout from "../../layouts/BaseLayout.astro";

const games = [
  {
    href: "/mini/linklink/",
    name: "连连看 · AI 版",
    mark: "连",
    desc: "牌面是各家 AI 公司的 logo，两个相同的图案拐两个弯以内连起来就消掉。",
    tag: "经典",
  },
  {
    href: "/mini/tetris/",
    name: "俄罗斯方块",
    mark: "块",
    desc: "七种方块往下掉，消行得分，等级越高掉得越快。键盘和手机都能玩。",
    tag: "经典",
  },
  {
    href: "/mini/minesweeper/",
    name: "扫雷",
    mark: "雷",
    desc: "初级到高级三档。第一下永远安全，右键或长按插旗。",
    tag: "经典",
  },
  {
    href: "/mini/snake/",
    name: "贪吃蛇",
    mark: "蛇",
    desc: "吃果子变长，越长越快。方向键、WASD 或直接滑动屏幕。",
    tag: "经典",
  },
];
---

<BaseLayout
  title="小游戏 | 宛瑜的小窝"
  description="不费脑子的东西：连连看之类的浏览器小游戏，打开就能玩，不用登录。"
>
  <div class="mini container-content">
    <header class="mini__header">
      <h1 class="mini__title">小游戏</h1>
      <p class="mini__lead">
        不费脑子的东西。打开就能玩，不用登录，也不会记你的分。
      </p>
    </header>

    <ul class="mini__list">
      {
        games.map((g) => (
          <li>
            <a href={g.href} class="mini__card">
              <span class="mini__mark" aria-hidden="true">{g.mark}</span>
              <span class="mini__body">
                <span class="mini__name">
                  {g.name}
                  <span class="mini__tag">{g.tag}</span>
                </span>
                <span class="mini__desc">{g.desc}</span>
              </span>
              <span class="mini__go" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mini__note">
      想下棋的话，<a href="/games/">那边有七盘</a>。
    </p>

    <p class="mini__back"><a href="/">← 回首页</a></p>
  </div>
</BaseLayout>

<style>
  .mini {
    padding-block: 3rem 5rem;
  }

  .mini__header {
    max-width: 34rem;
    margin-bottom: 2rem;
  }

  .mini__title {
    margin: 0 0 0.6rem;
  }

  .mini__lead {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.95rem;
  }

  .mini__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mini__card {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 100%;
    padding: 1.1rem 1.2rem;
    border: 1px solid color-mix(in srgb, var(--color-divider) 75%, transparent);
    border-radius: var(--radius-card);
    background-color: var(--color-surface);
    box-shadow: var(--shadow-card);
    text-decoration: none;
    color: inherit;
    transition: transform 200ms var(--ease-out-soft), box-shadow 200ms var(--ease-out-soft);
  }

  .mini__card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card-hover);
  }

  .mini__mark {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-brand) 30%, var(--color-surface));
    color: var(--color-brand-strong);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.1rem;
  }

  .mini__body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .mini__name {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-text-primary);
  }

  .mini__tag {
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-divider) 60%, transparent);
    color: var(--color-text-secondary);
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 400;
  }

  .mini__desc {
    color: var(--color-text-secondary);
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .mini__go {
    margin-left: auto;
    color: var(--color-brand-strong);
    font-size: 1.1rem;
  }

  .mini__note {
    margin-top: 1.75rem;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
  }

  .mini__back {
    margin-top: 1.25rem;
    font-size: 0.92rem;
  }
</style>
