---
import { getCollection } from "astro:content";
import SectionHeader from "./SectionHeader.astro";
import { getAlbumSlug, sortGalleryAlbums } from "../utils/gallery";

// 没有相册就整块不渲染：首页不该出现一个空卡片或占位格子。
const albums = sortGalleryAlbums(await getCollection("gallery")).slice(0, 6);
const hasAlbums = albums.length > 0;
---

{
  hasAlbums && (
    <section class="side-card gallery-preview" data-reveal="content">
      <SectionHeader emoji="📷" title="近期相册" linkHref="/gallery" linkLabel="查看更多 →" />

      <div class="gallery-preview__grid">
        {albums.map((album) => (
          <a
            href={`/gallery/${getAlbumSlug(album.id)}/`}
            class="gallery-preview__item"
            aria-label={`查看相册：${album.data.title}`}
          >
            <img
              src={album.data.cover.src}
              alt=""
              width={album.data.cover.width}
              height={album.data.cover.height}
              loading="lazy"
              decoding="async"
            />
          </a>
        ))}
      </div>
    </section>
  )
}

<style>
  .gallery-preview {
    background-color: var(--color-surface);
    border-radius: 20px;
    padding: 1.15rem 1.1rem 1.2rem;
    box-shadow: var(--shadow-card);
  }

  .gallery-preview__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.45rem;
  }

  .gallery-preview__item {
    aspect-ratio: 1;
    border-radius: 10px;
    overflow: hidden;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 35%);
  }

  .gallery-preview__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .gallery-preview__item:hover {
    transform: scale(1.04);
    box-shadow: 0 4px 12px rgb(91 81 72 / 10%);
  }
</style>
