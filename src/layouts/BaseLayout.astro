---
import { ClientRouter } from "astro:transitions";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import SiteAudioPlayer from "../components/SiteAudioPlayer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
}

const {
  title = "宛瑜的小窝",
  description = "记录一点生活，分享一点温柔。",
  type = "website",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? "https://linwanyu.top");
const ogImage = new URL("/og-cover.jpg", canonicalURL).href;
---

<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="UTF-8" />
    <!--
      Defense-in-depth only: GitHub Pages' own "Enforce HTTPS" setting for
      the linwanyu.top custom domain is the real fix (a platform-level
      redirect issued before any HTML/JS loads) and should be verified/kept
      on in the repo's Settings → Pages. This inline script is a client-side
      fallback for the rare case that setting is off or a stale www./http
      link is bookmarked — it only ever targets the known production
      hostnames, never localhost/preview URLs, so local `astro dev` is
      unaffected.
    -->
    <script is:inline>
      (function () {
        var canonicalHost = "linwanyu.top";
        var host = window.location.hostname;
        var isHttpOnApex = host === canonicalHost && window.location.protocol === "http:";
        var isWww = host === "www." + canonicalHost;
        if (isHttpOnApex || isWww) {
          window.location.replace(
            "https://" +
              canonicalHost +
              window.location.pathname +
              window.location.search +
              window.location.hash,
          );
        }
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="宛瑜的小窝" href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="canonical" href={canonicalURL.href} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="宛瑜的小窝" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col bg-background text-text-primary">
    <SiteAudioPlayer />
    <Navbar />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <ScrollReveal />
  </body>
</html>
